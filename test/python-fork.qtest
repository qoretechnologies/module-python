#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.

# Child processes created with fork() while other threads use Python.  The child of each test exits with exit(), so
# that the module's cleanup runs in it, and with it the exit-time code of every module loaded in the process: a fork
# test runs in its own process, whose loaded modules it controls.

%modern
%no-child-restrictions

%requires python
%requires QUnit
%requires FsUtil

%exec-class PythonForkTest

class PythonForkTest inherits QUnit::Test {
    constructor() : Test("python fork test", "1.0", \ARGV) {
        addTestCase("fork() while another thread holds the GIL", \forkGilHeldTest());
        addTestCase("fork() called from Python while another thread holds the GIL", \forkReturnToPythonTest());
        addTestCase("os.fork() in an interpreter of Qore", \osForkTest());
        addTestCase("the child deletes an interpreter that another thread used", \forkInterpreterInUseTest());
        addTestCase("Qore's fork() called from Python in a Python process", \hostedForkProtocolTest());
        addTestCase("Qore's fork() called from Python in a Python process with an interpreter of Qore",
            \hostedForkInterpreterTest());
        addTestCase("os.fork() in a Python process while a thread holds the mutex of the GIL",
            \hostedOsForkGilMutexTest());
        set_return_value(main());
    }

    # a child process created with fork() while another thread holds the GIL cannot use Python: the GIL can never be
    # released in the child.  The first use of Python raises PYTHON-FORK-ERROR, and the child exits normally.
    # Previously the child waited forever for the GIL on its first use of Python (the test runner's time limit is only
    # a guard).
    forkGilHeldTest() {
        if (!Option::HAVE_FORK) {
            testSkip("fork() is not available");
        }
        if (Python::FreeThreading) {
            testSkip("there is no GIL with free-threading (PEP 703)");
        }
        TmpDir tmp("python-fork-gil-");
        string go = tmp.path + DirSep + "go";
        string ready = tmp.path + DirSep + "ready";
        string block = tmp.path + DirSep + "block";
        # the child writes its result to a pipe, which the parent reads until the child has exited
        hash<PipeInfo> result = File::getPipe();
        # the thread holds the GIL in C calls (ctypes.PyDLL does not release it): once the parent has returned to Qore,
        # it signals that it holds the GIL with a write and then blocks in a read until the parent writes; the FIFOs
        # are opened for reading and writing, so that opening them never blocks and a read waits for data
        PythonProgram p("
import ctypes
import os
from threading import Thread

def make_fifos(*paths):
    for path in paths:
        os.mkfifo(path)

def hold_gil(go, ready, block):
    libc = ctypes.PyDLL(None)
    go_fd = os.open(go, os.O_RDWR)
    ready_fd = os.open(ready, os.O_RDWR)
    block_fd = os.open(block, os.O_RDWR)
    buf = ctypes.create_string_buffer(1)
    def target():
        # os.read() releases the GIL: Thread.start() returns, and the parent returns to Qore
        os.read(go_fd, 1)
        libc.write(ready_fd, b'x', 1)
        libc.read(block_fd, buf, 1)
        for fd in (go_fd, ready_fd, block_fd):
            os.close(fd)
    thread = Thread(target = target)
    thread.start()
    return thread

def join(thread):
    thread.join()

def add(x, y):
    return x + y
", "fork-gil.py");
        p.callFunction("make_fifos", go, ready, block);
        auto thread = p.callFunction("hold_gil", go, ready, block);
        {
            File go_file();
            go_file.open2(go, O_WRONLY);
            go_file.write(<78>);
        }
        # the thread holds the GIL when the byte can be read
        {
            ReadOnlyFile ready_file(ready);
            assertEq(<78>, ready_file.readBinary(1));
        }
        int pid = fork();
        if (!pid) {
            # the child reports the errors of a call in an existing interpreter and of the creation of a new one
            list<string> errors;
            try {
                p.callFunction("add", 1, 2);
                errors += "no error";
            } catch (hash<ExceptionInfo> ex) {
                errors += ex.err;
            }
            try {
                PythonProgram child("x = 1", "fork-gil-child.py");
                errors += "no error";
            } catch (hash<ExceptionInfo> ex) {
                errors += ex.err;
            }
            result.write.write(errors.join(","));
            # the result is complete when the child has exited, which closes the pipe: the module must not wait for
            # the GIL when it is deleted
            Qore::exit(0);
        }
        assertGt(0, pid);
        result.write.close();
        # the parent continues: the thread is released, and Python is used again
        {
            File block_file();
            block_file.open2(block, O_WRONLY);
            block_file.write(<78>);
        }
        p.callFunction("join", thread);
        assertEq(3, p.callFunction("add", 1, 2));
        # the parent reads until the child has exited
        string child_result;
        while (*binary data = result.read.readBinary(4096)) {
            child_result += data.toString();
        }
        assertEq("PYTHON-FORK-ERROR,PYTHON-FORK-ERROR", child_result);
    }

    # Python calls a Qore closure that calls fork() while another Python thread holds the GIL: in the child, the
    # closure cannot return to Python code; the child writes a message to stderr and exits instead of waiting forever
    # for the GIL.  The scenario runs in another process, whose stderr (with the child's) is read until both have
    # ended.
    forkReturnToPythonTest() {
        if (!Option::HAVE_FORK) {
            testSkip("fork() is not available");
        }
        if (Python::FreeThreading) {
            testSkip("there is no GIL with free-threading (PEP 703)");
        }
        string script = get_script_dir() + "python-fork-return.q";
        string output = backquote(sprintf("qore %s 2>&1", script));
        assertRegex("parent: child started", output);
        assertRegex("a child process created with fork\\(\\) cannot return to Python code", output);
    }

    # CPython supports os.fork() only in the main interpreter: the child of a fork made in a subinterpreter (every
    # interpreter of a PythonProgram or of a Program using Python) died with "Fatal Python error:
    # _PyInterpreterState_DeleteExceptMain: not main interpreter".  The subinterpreters are created with fork()
    # disallowed, so os.fork() raises RuntimeError in the interpreter, while processes can still be started.
    osForkTest() {
        if (!Option::HAVE_FORK) {
            testSkip("fork() is not available");
        }
        PythonProgram p("
import os
import subprocess

def fork():
    try:
        pid = os.fork()
    except RuntimeError as e:
        return 'RuntimeError: ' + str(e)
    if not pid:
        os._exit(0)
    os.waitpid(pid, 0)
    return 'forked'

def run():
    return subprocess.run(['sh', '-c', 'exit 3']).returncode
", "os-fork.py");
        assertRegex("^RuntimeError: fork not supported", p.callFunction("fork"));
        if (!Python::FreeThreading) {
            # processes can be started (free-threading subinterpreters are also created with exec disallowed)
            assertEq(3, p.callFunction("run"));
        }
    }

    # a child process created with fork() while other threads were in an interpreter, without the GIL (a Qore thread
    # in a Qore closure called from Python, a thread created by Python in such a closure), uses the interpreter,
    # starts a thread that uses it, and deletes it.  Previously the deletion waited forever for the Qore thread, which
    # was still counted as using the interpreter, and then for the Python thread in threading._shutdown(); the
    # interpreter is now left in memory in this case, since the threads of the parent cannot end in the child.
    forkInterpreterInUseTest() {
        if (!Option::HAVE_FORK) {
            testSkip("fork() is not available");
        }
        if (Python::FreeThreading) {
            testSkip("Python threads in sub-interpreters not supported with free-threading (PEP 703)");
        }
        # the child writes its result to a pipe, which the parent reads until the child has exited
        hash<PipeInfo> result = File::getPipe();
        PythonProgram p("
from threading import Thread

# calls the Qore closure, which runs without the GIL, in this thread
def call(closure):
    closure()

# calls the Qore closure in a thread created by Python
def start(closure):
    thread = Thread(target = closure)
    thread.start()
    return thread

def join(thread):
    thread.join()

def add(x, y):
    return x + y
", "fork-in-use.py");
        Queue ready();
        Queue release();
        code wait_closure = sub () {
            ready.push(True);
            release.get();
        };
        # a Qore thread in the interpreter
        Counter qore_thread(1);
        background sub () {
            on_exit qore_thread.dec();
            p.callFunction("call", wait_closure);
        }();
        # a Python thread in the interpreter
        auto python_thread = p.callFunction("start", wait_closure);
        ready.get();
        ready.get();
        # both threads wait in the closure, without the GIL
        int pid = fork();
        if (!pid) {
            list<string> r;
            try {
                r += sprintf("call: %d", p.callFunction("add", 1, 2));
                # a new thread of the child uses the interpreter
                Queue q();
                background sub () {
                    try {
                        q.push(sprintf("thread: %d", p.callFunction("add", 2, 3)));
                    } catch (hash<ExceptionInfo> ex) {
                        q.push(sprintf("thread: %s", ex.err));
                    }
                }();
                r += q.get();
                delete p;
                r += "deleted";
            } catch (hash<ExceptionInfo> ex) {
                r += ex.err;
            }
            result.write.write(r.join(","));
            Qore::exit(0);
        }
        assertGt(0, pid);
        result.write.close();
        release.push(True);
        release.push(True);
        qore_thread.waitForZero();
        p.callFunction("join", python_thread);
        string child_result;
        while (*binary data = result.read.readBinary(4096)) {
            child_result += data.toString();
        }
        assertEq("call: 3,thread: 5,deleted", child_result);
    }

    # Qore's fork() called from Python code in a Python process hosting Qore (the main interpreter) while a
    # non-daemon thread runs: Python's fork protocol runs, as with os.fork(), so the at-fork functions of Python run in
    # the parent and in the child, and the threading module of the child knows that only the thread calling fork()
    # exists in it: the child can use Python and Qore and exit normally.  Previously Python was not told of the
    # fork(): its at-fork functions did not run, the child still listed the thread of the parent, and its exit waited
    # for it forever (the script kills such a child).
    hostedForkProtocolTest() {
        if (!Option::HAVE_FORK) {
            testSkip("fork() is not available");
        }
        string output = runHosted("fork-protocol.py", "
import os, sys, threading
import qoreloader
from qore.__root__.Qore import fork, sprintf

events = []
os.register_at_fork(before=lambda: events.append('before'), after_in_parent=lambda: events.append('parent'),
    after_in_child=lambda: events.append('child'))
release_r, release_w = os.pipe()
result_r, result_w = os.pipe()
thread = threading.Thread(target=lambda: os.read(release_r, 1))
thread.start()
pid = fork()
if pid == 0:
    os.close(result_r)
    line = '%d %s %s\\n' % (len(threading.enumerate()), ','.join(events), sprintf('%d', 3))
    os.write(result_w, line.encode())
    os.close(result_w)
    # waits for the non-daemon threads of this process
    sys.exit(0)
os.close(result_w)
data = b''
while not data.endswith(b'\\n'):
    chunk = os.read(result_r, 256)
    if not chunk:
        break
    data += chunk
if not data.startswith(b'1 '):
    # its exit would wait for the thread of the parent forever
    os.kill(pid, 9)
_, status = os.waitpid(pid, 0)
os.write(release_w, b'x')
thread.join()
print('child: %s parent: %s status: %d' % (data.decode().strip(), ','.join(events), status))
");
        assertRegex("child: 1 before,child 3 parent: before,parent status: 0", output);
    }

    # Qore's fork() called from Python code in a Python process hosting Qore that has an interpreter of Qore (a
    # PythonProgram): Python's fork protocol is not run, since Python crashes the child when it deletes the other
    # interpreters in it (CPython issue gh-139759, also with os.fork()); the child can use the interpreter
    hostedForkInterpreterTest() {
        if (!Option::HAVE_FORK) {
            testSkip("fork() is not available");
        }
        string output = runHosted("fork-interpreter.py", "
import os, sys
import qoreloader
from qore.__root__.Qore import fork
from qore.__root__.Python import PythonProgram

p = PythonProgram('def f():\\n    return 42\\n', 'sub.py')
result_r, result_w = os.pipe()
pid = fork()
if pid == 0:
    os.close(result_r)
    try:
        msg = 'call: %r' % (p.callFunction('f'),)
    except BaseException as e:
        msg = 'call error: %s' % (type(e).__name__,)
    del p
    os.write(result_w, (msg + '\\n').encode())
    os.close(result_w)
    sys.exit(0)
os.close(result_w)
data = b''
while True:
    chunk = os.read(result_r, 256)
    if not chunk:
        break
    data += chunk
_, status = os.waitpid(pid, 0)
print('child: %s status: %d' % (data.decode().strip(), status))
");
        assertRegex("child: call: 42 status: 0", output);
    }

    # os.fork() in a Python process hosting Qore while another thread holds the mutex of the GIL, as a thread waiting
    # for the GIL does from time to time: Python recreates the GIL in the child of its fork protocol, so the child
    # can use Python and Qore.  Previously the module found the GIL lost in the child: the call to Qore returned
    # into Python code, so the child wrote a message and exited with status 1.  The mutex is held with a test hook of
    # debug builds of the module.
    hostedOsForkGilMutexTest() {
        if (!Option::HAVE_FORK) {
            testSkip("fork() is not available");
        }
        if (Python::FreeThreading) {
            testSkip("there is no GIL with free-threading (PEP 703)");
        }
        string output = runHosted("os-fork-gil-mutex.py", "
import os, sys
import qoreloader
from qore.__root__.Qore import sprintf

if not hasattr(qoreloader, '_test_hold_gil_mutex'):
    print('skip: the module has no test hooks (not a debug build)')
    sys.exit(0)
result_r, result_w = os.pipe()
# this thread keeps the GIL while the hook's thread holds its mutex
qoreloader._test_hold_gil_mutex()
pid = os.fork()
if pid == 0:
    try:
        msg = 'call: ' + sprintf('%d', 3)
    except BaseException as e:
        msg = 'call error: %s: %s' % (type(e).__name__, e)
    os.write(result_w, (msg + '\\n').encode())
    os._exit(0)
qoreloader._test_release_gil_mutex()
os.close(result_w)
data = b''
while True:
    chunk = os.read(result_r, 1024)
    if not chunk:
        break
    data += chunk
_, status = os.waitpid(pid, 0)
print('child: %s status: %d' % (data.decode().strip(), status))
");
        if (output =~ /^skip: /m) {
            testSkip((output =~ x/^skip: (.*)$/m)[0]);
        }
        assertRegex("child: call: 3 status: 0", output);
    }

    #! runs Python code in a Python process hosting Qore with the module, and returns its output (stdout and stderr)
    /** The Python executable is the one of the Python library of the module; the test is skipped if it is not found.
    */
    private string runHosted(string name, string code) {
        PythonProgram p("
import sys

def python():
    return '%s/bin/python%d.%d' % (sys.base_prefix, sys.version_info[0], sys.version_info[1])
", "python-executable.py");
        string python = p.callFunction("python");
        if (!is_executable(python)) {
            testSkip(sprintf("the Python executable %y was not found", python));
        }
        TmpDir tmp("python-hosted-");
        # Python imports the module as the qoreloader extension module
        symlink(get_module_hash().python.filename, tmp.path + DirSep + "qoreloader.so");
        string script = tmp.path + DirSep + name;
        {
            File f();
            f.open2(script, O_CREAT | O_WRONLY | O_TRUNC, 0644);
            f.write(code);
        }
        return backquote(sprintf("PYTHONPATH=%s %s -B -W ignore::DeprecationWarning %s 2>&1", tmp.path, python,
            script));
    }
}
