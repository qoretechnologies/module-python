#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.

# The Python program that Python code runs in when sandboxed Programs reach Python through library code: the Python
# state that a caller creates belongs to the caller's own Python program, or to the library's when library code that
# loaded python runs it, never to another caller's or to the host's; code that a sandbox governs and that has no
# Python program of its own is refused the main interpreter's program, which the whole process shares

%modern
%no-child-restrictions
%prepend-module-path "${SCRIPT_DIR}/../qlib"
%append-module-path "${SCRIPT_DIR}/caller-program-context"

%requires python
%requires QUnit
# the libraries are loaded by the host: library code that every Program shares
%requires CpcLib
%requires CpcPyLib

%exec-class CallerProgramContextTest

class CallerProgramContextTest inherits QUnit::Test {
    public {
        # the code of each sandboxed Program
        const Source = "%requires CpcLib\n"
            "%requires CpcPyLib\n"
            "string sub stmt(string name, string val) { return sprintf(\"%s = %y\", name, val); }\n"
            "sub set_direct(string name, string val) {\n"
            "    Python::PythonProgram::evalStatementKeep(stmt(name, val));\n"
            "}\n"
            "auto sub get(string name) {\n"
            "    return Python::PythonProgram::evalExpression(sprintf(\"globals().get(%y)\", name));\n"
            "}\n"
            "# runs the code with the statement in library code without python, in the given way\n"
            "sub run_via(string how, code c, string s) {\n"
            "    switch (how) {\n"
            "        case \"function\": CpcLib::lib_call(c, s); break;\n"
            "        case \"closure\": { code f = CpcLib::lib_closure(c); f(s); break; }\n"
            "        case \"static method\": CpcLib::Lib::call(c, s); break;\n"
            "        case \"thread\": {\n"
            "            auto rv = CpcLib::lib_thread(c, s);\n"
            "            if (rv) {\n"
            "                throw rv.err, rv.desc;\n"
            "            }\n"
            "            break;\n"
            "        }\n"
            "        default: throw \"TEST-ERROR\", how;\n"
            "    }\n"
            "}\n"
            "sub via_lib(string how, string name, string val) {\n"
            "    run_via(how, \\Python::PythonProgram::evalStatementKeep(), stmt(name, val));\n"
            "}\n"
            "sub via_pylib(string how, string name, string val) {\n"
            "    string s = stmt(name, val);\n"
            "    switch (how) {\n"
            "        case \"function\": CpcPyLib::lib_stmt(s); break;\n"
            "        case \"closure\": { code f = CpcPyLib::lib_closure(); f(s); break; }\n"
            "        case \"static method\": CpcPyLib::Lib::stmt(s); break;\n"
            "        default: throw \"TEST-ERROR\", how;\n"
            "    }\n"
            "}\n"
            "auto sub pylib_get(string name) {\n"
            "    return CpcPyLib::lib_expr(sprintf(\"globals().get(%y)\", name));\n"
            "}\n"
            "sub main_stmt(string s) {\n"
            "    Python::PythonProgram::evalStatement(s);\n"
            "}\n"
            "sub main_stmt_via_lib(string how, string s) {\n"
            "    run_via(how, \\Python::PythonProgram::evalStatement(), s);\n"
            "}\n"
            "auto sub expr(string s) {\n"
            "    return Python::PythonProgram::evalExpression(s);\n"
            "}\n"
            "# returns a Python function of the Program's own Python program that calls the code that it is given\n"
            "code sub get_callit() {\n"
            "    Python::PythonProgram::evalStatementKeep(\"def cpc_callit(f):\\n    return f()\\n\");\n"
            "    return Python::PythonProgram::evalExpression(\"cpc_callit\");\n"
            "}\n"
            "# returns a closure that writes to and reads from the __main__ module of the Python program that it uses\n"
            "code sub get_reader(string name) {\n"
            "    return auto sub () {\n"
            "        Python::PythonProgram::evalStatement(\"import __main__\\n__main__.cpc_reader_was_here = 1\\n\");\n"
            "        return Python::PythonProgram::evalExpression(sprintf(\"getattr(__import__('__main__'), %y, None)\", "
            "name));\n"
            "    };\n"
            "}\n"
            "sub set_save_object_callback_static() {\n"
            "    Python::PythonProgram::setSaveObjectCallback(sub (object o) {});\n"
            "}\n"
            "sub set_save_object_callback_function() {\n"
            "    Python::set_save_object_callback(sub (object o) {});\n"
            "}\n";

        const Ways = ("function", "closure", "static method");
    }

    constructor() : QUnit::Test("python caller program context", "1.0", \ARGV) {
        addTestCase("direct calls use each Program's own Python program", \testDirect());
        addTestCase("caller code run by library code uses the caller's Python program", \testThroughLibrary());
        addTestCase("library code that loaded python uses the library's Python program", \testLibraryPython());
        addTestCase("sandboxed code without a Python program is refused the main interpreter's",
            \testSandboxedWithoutPythonProgram());
        addTestCase("sandboxed code without a Python program cannot set the main interpreter's object callback",
            \testSaveObjectCallback());
        addTestCase("sandboxed code called from another sandbox's Python code uses its own Python program",
            \testCalledFromAnotherSandbox());
        addTestCase("sandboxed code called from the host's Python code uses its own Python program",
            \testCalledFromHost());
        set_return_value(main());
    }

    # returns a sandboxed Program that may use Python, an uncontrolled API
    private Program sandboxed(string label, int opts = PO_NEW_STYLE) {
        SandboxManager sm();
        sm.setUncontrolledApiPolicy(True);
        Program pgm(opts);
        pgm.setSandboxManager(sm);
        pgm.parse(Source, label);
        return pgm;
    }

    private auto hostGet(string name) {
        return Python::PythonProgram::evalExpression(sprintf("globals().get(%y)", name));
    }

    # checks that the variable has the value of exactly the Program that set it
    private checkOwn(string name, Program a, Program b, string what) {
        assertEq("A", a.callFunction("get", name), what + ": A's own Python program");
        assertEq("B", b.callFunction("get", name), what + ": B's own Python program");
        assertNothing(hostGet(name), what + ": the host's Python program");
        assertNothing(a.callFunction("pylib_get", name), what + ": the library's Python program");
    }

    testDirect() {
        Program a = sandboxed("cpc-a");
        Program b = sandboxed("cpc-b");
        a.callFunction("set_direct", "cpc_direct", "A");
        b.callFunction("set_direct", "cpc_direct", "B");
        checkOwn("cpc_direct", a, b, "direct");
    }

    testThroughLibrary() {
        Program a = sandboxed("cpc-a");
        Program b = sandboxed("cpc-b");
        foreach string how in (Ways + ("thread",)) {
            string name = "cpc_lib_" + replace(how, " ", "_");
            a.callFunction("via_lib", how, name, "A");
            b.callFunction("via_lib", how, name, "B");
            checkOwn(name, a, b, "library " + how);
        }
    }

    # the Python program of library code that loaded python holds the library's state, which every caller of the
    # library shares, as the library's Qore state is; it is never a caller's or the host's
    testLibraryPython() {
        Program a = sandboxed("cpc-a");
        Program b = sandboxed("cpc-b");
        foreach string how in (Ways) {
            string name = "cpc_pylib_" + replace(how, " ", "_");
            a.callFunction("via_pylib", how, name, "A");
            assertEq("A", a.callFunction("pylib_get", name), how);
            b.callFunction("via_pylib", how, name, "B");
            assertEq("B", a.callFunction("pylib_get", name), how);
            assertNothing(a.callFunction("get", name), how + ": A's own Python program");
            assertNothing(b.callFunction("get", name), how + ": B's own Python program");
            assertNothing(hostGet(name), how + ": the host's Python program");
        }
    }

    # returns the error code of the exception that the call raises, or nothing if it raises none
    private *string callErr(Program p, string func, softlist<auto> args) {
        try {
            p.callFunctionArgs(func, args);
        } catch (hash<ExceptionInfo> ex) {
            return ex.err;
        }
    }

    # a Program that does not inherit the Program data of its parent has no Python program of its own; code that a
    # sandbox governs there must not run in the main interpreter's program, which the whole process shares
    testSandboxedWithoutPythonProgram() {
        Program a = sandboxed("cpc-nodata-a", PO_NEW_STYLE | PO_NO_INHERIT_PROGRAM_DATA);
        Program b = sandboxed("cpc-nodata-b", PO_NEW_STYLE | PO_NO_INHERIT_PROGRAM_DATA);
        # each sandbox sets a variable in the __main__ module of the interpreter that it runs in, which must be its
        # own: the second one raises an exception if it finds the variable that the first one set
        string probe = "import __main__\nif hasattr(__main__, 'cpc_shared'):\n    raise RuntimeError('shared')\n"
            "__main__.cpc_shared = 1\n";
        *string a_err = callErr(a, "main_stmt", probe);
        *string b_err = callErr(b, "main_stmt", probe);
        # a Program that a sandbox does not govern uses the main interpreter's program
        Program u(PO_NEW_STYLE | PO_NO_INHERIT_PROGRAM_DATA);
        u.parse(Source, "cpc-nodata-u");
        *string u_err = callErr(u, "main_stmt", "import __main__\nif hasattr(__main__, 'cpc_shared'):\n"
            "    raise RuntimeError('shared')\n");
        assertNothing(u_err, "the state of a sandbox reached the main interpreter, which the whole process shares");
        assertEq("PYTHON-ERROR", a_err, "the first sandbox ran Python code in the main interpreter");
        assertEq("PYTHON-ERROR", b_err, "the second sandbox ran Python code in the main interpreter");

        foreach Program p in ((a, b)) {
            assertThrows("PYTHON-ERROR", "no Python program context", \p.callFunction(), ("main_stmt", "pass"));
            foreach string how in (Ways + ("thread",)) {
                assertThrows("PYTHON-ERROR", "no Python program context", \p.callFunction(),
                    ("main_stmt_via_lib", how, "import __main__\n__main__.cpc_shared_lib = 1\n"));
                assertThrows("PYTHON-ERROR", "no Python program context", \p.callFunction(), ("via_lib", how,
                    "cpc_shared_" + replace(how, " ", "_"), "A"));
            }
            assertThrows("PYTHON-ERROR", "no Python program context", \p.callFunction(), ("set_direct",
                "cpc_shared_keep", "A"));
            assertThrows("PYTHON-ERROR", "no Python program context", \p.callFunction(), ("expr", "1 + 1"));
        }
        assertNothing(callErr(u, "main_stmt", "import __main__\nif hasattr(__main__, 'cpc_shared_lib'):\n"
            "    raise RuntimeError('shared')\n"));

        # the sandboxes keep using the Python programs of the libraries, which they do not own
        a.callFunction("via_pylib", "function", "cpc_nodata_pylib", "A");
        assertEq("A", a.callFunction("pylib_get", "cpc_nodata_pylib"));
    }

    # the object callback of the main interpreter's program, which the whole process shares, is not set by code that a
    # sandbox governs
    testSaveObjectCallback() {
        Program p = sandboxed("cpc-nodata-socb", PO_NEW_STYLE | PO_NO_INHERIT_PROGRAM_DATA);
        assertThrows("PYTHON-ERROR", "Python program context", \p.callFunction(),
            "set_save_object_callback_function");
        assertThrows("PYTHON-ERROR", "no Python program context", \p.callFunction(),
            "set_save_object_callback_static");
    }

    # sandboxed code that the Python code of another sandbox calls uses its own Python program, never the other
    # sandbox's, or is refused if it has none
    testCalledFromAnotherSandbox() {
        Program a = sandboxed("cpc-callit-a");
        a.callFunction("set_direct", "cpc_a_secret", "A");
        a.callFunction("main_stmt", "import __main__\n__main__.cpc_a_secret = 'A'\n");
        code callit = a.callFunction("get_callit");

        Program b = sandboxed("cpc-callit-b");
        code reader = b.callFunction("get_reader", "cpc_a_secret");
        assertNothing(callit(reader), "B read A's Python state");
        assertEq(1, b.callFunction("expr", "getattr(__import__('__main__'), 'cpc_reader_was_here', None)"),
            "B's own Python program");
        assertNothing(a.callFunction("expr", "getattr(__import__('__main__'), 'cpc_reader_was_here', None)"),
            "B wrote A's Python state");

        Program n = sandboxed("cpc-callit-nodata", PO_NEW_STYLE | PO_NO_INHERIT_PROGRAM_DATA);
        code nreader = n.callFunction("get_reader", "cpc_a_secret");
        assertThrows("PYTHON-ERROR", "no Python program context", callit, (nreader,));
        assertNothing(a.callFunction("expr", "getattr(__import__('__main__'), 'cpc_reader_was_here', None)"),
            "a sandbox without a Python program wrote A's Python state");
    }

    # sandboxed code that the host's Python code calls uses its own Python program, never the host's, or is refused if
    # it has none
    testCalledFromHost() {
        Python::PythonProgram::evalStatement("import __main__\n__main__.cpc_host_secret = 'HOST'\n");
        Python::PythonProgram::evalStatementKeep("def cpc_host_callit(f):\n    return f()\n");
        code callit = Python::PythonProgram::evalExpression("cpc_host_callit");

        Program b = sandboxed("cpc-host-b");
        code reader = b.callFunction("get_reader", "cpc_host_secret");
        assertNothing(callit(reader), "the sandbox read the host's Python state");
        assertEq(1, b.callFunction("expr", "getattr(__import__('__main__'), 'cpc_reader_was_here', None)"),
            "the sandbox's own Python program");
        assertNothing(Python::PythonProgram::evalExpression("getattr(__import__('__main__'), 'cpc_reader_was_here', "
            "None)"), "the sandbox wrote the host's Python state");

        Program n = sandboxed("cpc-host-nodata", PO_NEW_STYLE | PO_NO_INHERIT_PROGRAM_DATA);
        code nreader = n.callFunction("get_reader", "cpc_host_secret");
        assertThrows("PYTHON-ERROR", "no Python program context", callit, (nreader,));
        assertNothing(Python::PythonProgram::evalExpression("getattr(__import__('__main__'), 'cpc_reader_was_here', "
            "None)"), "a sandbox without a Python program wrote the host's Python state");
    }
}
