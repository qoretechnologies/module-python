#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

# Copyright (C) 2026 Qore Technologies, s.r.o.

# An interpreter is finalized in a thread other than the thread that created it or that imported threading: the
# finalization must not wait for a thread that has ended (Python < 3.13 waited forever for the sentinel lock of the
# thread that imported threading)

%modern

%requires python
%requires QUnit
%requires FsUtil

%exec-class PythonInterpreterEndTest

class PythonInterpreterEndTest inherits QUnit::Test {
    private {
        #! the longest time to finalize an interpreter
        const MaxEnd = 30s;
    }

    constructor() : Test("PythonInterpreterEndTest", "1.0", \ARGV) {
        addTestCase("created and used in a thread that ended", \createdInEndedThread());
        addTestCase("used and destroyed in another thread", \usedInOtherThread());
        addTestCase("Program destroyed in another thread", \programDestroyedInOtherThread());
        addTestCase("the finalizing thread has the identifier of the ended threading main thread", \threadingMainThreadEnded());
        addTestCase("a daemon thread still runs when the interpreter is destroyed", \daemonThreadAtEnd());
        addTestCase("a non-daemon thread still runs when the interpreter is destroyed", \nonDaemonThreadAtEnd());
        set_return_value(main());
    }

    #! the interpreter is created and imports threading in a thread that ends; it is destroyed in this thread
    createdInEndedThread() {
        Queue q();
        background sub () {
            PythonProgram p("import threading\nt = threading.Thread(target=lambda: None)\nt.start()\nt.join()\n",
                "created-in-ended-thread");
            p.run();
            q.push(p);
        }();
        endInThread(q.get());
    }

    #! the interpreter is created in a thread that ends; threading is imported and the interpreter destroyed here
    usedInOtherThread() {
        Queue q();
        background sub () {
            q.push(new PythonProgram("x = 1\n", "used-in-other-thread"));
        }();
        PythonProgram p = q.get();
        p.evalStatement("import threading\nt = threading.Thread(target=lambda: None)\nt.start()\nt.join()\n");
        endHere(p);
    }

    #! a Qore Program that uses Python is created here and destroyed in another thread
    programDestroyedInOtherThread() {
        Program pgm(PO_NEW_STYLE);
        pgm.loadModule("python");
        pgm.parse("%module-cmd(python) import threading\nsub f() {}\n", "program-destroyed-in-other-thread");
        endInThread(pgm);
    }

    #! the thread that finalizes the interpreter has the identifier of the thread that imported threading, which ended
    /** threading._shutdown() of Python 3.12 and earlier treats the finalizing thread as the thread that imported
        threading in the interpreter (its "main thread") if their identifiers are equal, and then expects the main
        thread's state to still exist; when the main thread has ended (its state deleted, which releases its sentinel
        lock) and a new thread gets its identifier (musl and glibc reuse them; ex: "created and used in a thread that
        ended"), _shutdown() failed "assert tlock.locked()", reported as an exception ignored in threading._shutdown,
        and did not wait for the non-daemon threads.  The reuse of an identifier cannot be arranged, so the state it
        leaves is made directly: the main thread's sentinel is a released lock (no longer waited for by _shutdown()),
        and its identifier is the one of the finalizing thread.  The exceptions that Python cannot raise (the "unraisable" ones) are written to a file.
    */
    threadingMainThreadEnded() {
        list<softint> version = (Python::PythonVersion =~ x/^([0-9]+)\.([0-9]+)/);
        if (version[0] > 3 || (version[0] == 3 && version[1] >= 13)) {
            testSkip("threading._shutdown() of Python 3.13 and later does not compare thread identifiers");
        }
        TmpDir tmp("python-threading-main-ended-");
        string unraisable = tmp.path + DirSep + "unraisable";
        PythonProgram p(sprintf("
import _thread
import sys
import threading

def record(info, path = %y):
    with open(path, 'a') as f:
        f.write('%%s: %%s\\n' %% (type(info.exc_value).__name__, info.exc_value))

sys.unraisablehook = record

# the state that the end of the main thread leaves, with the identifier of this thread: its sentinel lock, which
# threading._shutdown() also waits for, is released
def main_thread_ended():
    main = threading._main_thread
    with threading._shutdown_locks_lock:
        threading._shutdown_locks.discard(main._tstate_lock)
    main._tstate_lock = _thread.allocate_lock()
    main._ident = threading.get_ident()
", unraisable), "threading-main-ended");
        p.callFunction("main_thread_ended");
        delete p;
        string errors = is_file(unraisable) ? ReadOnlyFile::readTextFile(unraisable) : "";
        assertEq("", errors, "no exception is ignored while the interpreter is finalized");
    }

    #! a daemon thread still runs when the interpreter is destroyed: it cannot be waited for, and the process continues
    /** Python 3.13 and earlier abort the process ("Py_EndInterpreter: not the last thread") when an interpreter is
        finalized while a daemon thread still has a state in it, so the interpreter is left in memory with the thread
        running its code: the thread continues when it is released, and a call it makes to Qore raises a Python
        exception.  Python 3.14 finalizes the interpreter and makes the thread exit when it next takes the GIL.
        Previously the process aborted with Python 3.13 and earlier.
    */
    daemonThreadAtEnd() {
        if (Python::FreeThreading) {
            # daemon threads are disabled in the interpreters of the module with free-threading (PEP 703)
            PythonProgram p("
from threading import Thread

def start():
    Thread(target = lambda: None, daemon = True).start()
", "daemon-disabled.py");
            assertThrows("builtins.RuntimeError", "daemon threads are disabled", \p.callFunction(), "start");
            return;
        }
        TmpDir tmp("python-daemon-end-");
        string ready = tmp.path + DirSep + "ready";
        string release = tmp.path + DirSep + "release";
        string result = tmp.path + DirSep + "result";
        PythonProgram p("
import os
import qoreloader
from qore.__root__.Qore import now
from threading import Thread

def make_fifos(*paths):
    for path in paths:
        os.mkfifo(path)

def start(ready, release, result):
    ready_fd = os.open(ready, os.O_RDWR)
    release_fd = os.open(release, os.O_RDWR)
    result_fd = os.open(result, os.O_RDWR)
    def target():
        os.write(ready_fd, b'x')
        os.read(release_fd, 1)
        try:
            now()
            msg = 'called Qore'
        except Exception as e:
            msg = type(e).__name__
        os.write(result_fd, msg.encode())
        for fd in (ready_fd, release_fd, result_fd):
            os.close(fd)
    Thread(target = target, daemon = True).start()
", "daemon-at-end.py");
        p.callFunction("make_fifos", ready, release, result);
        p.callFunction("start", ready, release, result);
        {
            ReadOnlyFile ready_file(ready);
            assertEq(<78>, ready_file.readBinary(1));
        }
        # the thread runs in the interpreter, waiting in os.read() without the GIL
        delete p;
        # the process continues and can use Python
        PythonProgram other("", "after-daemon-at-end.py");
        assertEq(2, other.evalExpression("1 + 1"));
        list<softint> version = (Python::PythonVersion =~ x/^([0-9]+)\.([0-9]+)/);
        if (version[0] > 3 || (version[0] == 3 && version[1] >= 14)) {
            # Python 3.14 makes the thread exit when it takes the GIL again
            return;
        }
        # the thread continues in the interpreter that was left
        File release_file();
        release_file.open2(release, O_WRONLY);
        release_file.write(<78>);
        ReadOnlyFile result_file(result);
        string msg;
        while (msg.size() < "RuntimeError".size() && (*binary data = result_file.readBinary(64))) {
            msg += data.toString();
        }
        assertEq("RuntimeError", msg, "the call to Qore after the interpreter's Program was destroyed fails");
    }

    #! a non-daemon thread still runs when the interpreter is destroyed: the destruction waits for it, as in Python
    nonDaemonThreadAtEnd() {
        TmpDir tmp("python-non-daemon-end-");
        string ready = tmp.path + DirSep + "ready";
        string release = tmp.path + DirSep + "release";
        PythonProgram p("
import os
from threading import Thread

def make_fifos(*paths):
    for path in paths:
        os.mkfifo(path)

def start(ready, release):
    ready_fd = os.open(ready, os.O_RDWR)
    release_fd = os.open(release, os.O_RDWR)
    def target():
        os.write(ready_fd, b'x')
        os.read(release_fd, 1)
        os.close(ready_fd)
        os.close(release_fd)
    Thread(target = target).start()
", "non-daemon-at-end.py");
        p.callFunction("make_fifos", ready, release);
        p.callFunction("start", ready, release);
        {
            ReadOnlyFile ready_file(ready);
            assertEq(<78>, ready_file.readBinary(1));
        }
        Counter done(1);
        background sub () {
            delete p;
            done.dec();
        }();
        # the destruction waits for the thread, which ends when it is released
        File release_file();
        release_file.open2(release, O_WRONLY);
        release_file.write(<78>);
        done.waitForZero();
        assertEq(0, done.getCount(), "the interpreter is destroyed after the thread has ended");
    }

    #! destroys the object in another thread
    private endInThread(object obj) {
        Counter done(1);
        background sub () {
            delete obj;
            done.dec();
        }();
        checkEnd(done);
    }

    #! destroys the object in this thread, bounded by a watchdog thread
    private endHere(object obj) {
        Counter done(1);
        Counter watchdog(1);
        background sub () {
            if (done.waitForZero(MaxEnd)) {
                stderr.printf("the Python interpreter was not finalized within %y\n", MaxEnd);
                # the stuck thread would also keep the process from exiting
                Qore::exit(1);
            }
            watchdog.dec();
        }();
        delete obj;
        done.dec();
        watchdog.waitForZero();
        assertTrue(True, "the interpreter is finalized");
    }

    private checkEnd(Counter done) {
        if (done.waitForZero(MaxEnd)) {
            stderr.printf("the Python interpreter was not finalized within %y\n", MaxEnd);
            # the stuck thread would keep the process from exiting
            Qore::exit(1);
        }
        assertEq(0, done.getCount(), "the interpreter is finalized");
    }
}
