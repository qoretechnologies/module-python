hs = HttpServer(log, log)
ws = MyWebSocketHandler()
hs.setDefaultHandler('ws', ws)
port = hs.addListener(0)['port']

def get_port():
    global port
    return port

def stop():
    global hs
    hs.stop()
            ", "ws.py");

            int port = p.callFunction("get_port");
            assertGt(0, port);
            Queue q();
            code callback = sub (data msg) {
                q.push(msg);
            };
            WebSocketClient wsc(callback, {"url": "ws://localhost:" + port});
            wsc.connect();
            on_exit wsc.disconnect();
            wsc.send("test");
            assertEq("default response", q.get(10s));
            # stop() must be called from the main thread (Gate owner), but it
            # waits for all connections to drain first.  Disconnect the client
            # in a background thread so the main thread's stop() can complete.
            # The main thread reaches p.callFunction("stop") before the new
            # thread starts due to thread-creation overhead.
            background wsc.disconnect();
            p.callFunction("stop");
        }
    }

    pythonCallbackTest() {
        # Uses background threads which aren't compatible with free-threading mode
        if (Python::FreeThreading) {
            testSkip("Background threads with Python not supported with free-threading (PEP 703)");
        }

        PythonProgram p("
class c:
    def __init__(self):
        self.d = {
            'x': 1,
        }

    def get(self):
        return self.t

    def t(self):
        return self.d['x']

    @classmethod
    def tc():
        return 2

    @staticmethod
    def sm():
        return 3

def get_method():
    c0 = c()
    return c0.get()

def get_cm():
    return c.tc

def get_sm():
    return c.sm

def test_code(code):
    code(1)
        ", "test.py");

        code c = p.callFunction("get_method");
        assertEq(1, c());

        Queue q();
        code bg = auto sub (code c) {
            q.push(c());
        };
        background bg(c);
        assertEq(1, q.get());

        c = p.callFunction("get_cm");
        assertEq(2, c());

        background bg(c);
        assertEq(2, q.get());

        c = p.callFunction("get_sm");
        assertEq(3, c());

        background bg(c);
        assertEq(3, q.get());

        int i;
        code inc = sub(int d) {
            i += d;
        };
        p.callFunction("test_code", inc);
        assertEq(1, i);
    }

    #! A container member holding a weak or opaque reference must convert as its target
    /** A member assigned with ":=" or "@=" is stored in its container as the reference itself, and
        getPythonDict()/getPythonList() pass what the container holds back to getPythonValue().
        Without QoreValue::resolveIndirect() the reference reaches the fall-through at the end of
        getPythonValueIntern(), which returns None for anything it does not recognise -- so the
        member silently arrived in Python as None instead of its hash or list.
    */
    indirectReferencesTest() {
        hash<auto> inner = {"a": 1, "b": "two"};
        list<auto> ilist = (1, "two", 3);

        PythonProgram p("def probe(v):
    return v
", "indirect-references");

        # dict and list are walked separately, so cover both as holder and as target
        hash<auto> weak = {};
        weak{"h"} := inner;
        weak{"l"} := ilist;
        assertEq({"h": inner, "l": ilist}, p.callFunction("probe", weak),
            "weak references in a hash convert as their targets");

        list<auto> weak_list = ();
        weak_list[0] := inner;
        assertEq((inner,), p.callFunction("probe", weak_list),
            "a weak reference in a list converts as its target");

        hash<auto> opaque = {};
        opaque{"h"} @= inner;
        opaque{"l"} @= ilist;
        assertEq({"h": inner, "l": ilist}, p.callFunction("probe", opaque),
            "opaque references in a hash convert as their targets");

        list<auto> opaque_list = ();
        opaque_list[0] @= ilist;
        assertEq((ilist,), p.callFunction("probe", opaque_list),
            "an opaque reference in a list converts as its target");
    }

