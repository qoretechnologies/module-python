    # SandboxManager::requestInterrupt() stops Python code that runs (a pure Python loop, and a loop that calls Qore)
    # with PROGRAM-INTERRUPTED; the interrupt is not raised in Python code that the thread runs after it
    runningInterruptTest() {
        if (Python::FreeThreading) {
            testSkip("Background threads with Python not supported with free-threading (PEP 703)");
        }
        Program p(PO_NEW_STYLE | PO_STRICT_ARGS | PO_REQUIRE_TYPES);
        p.loadModule("python");
        p.parse("
our PythonProgram pp('
def loop(q):
    q.push(\"in python\")
    n = 0
    while True:
        n += 1
def qore_loop(q):
    q.push(\"in python\")
    while True:
        q.size()
def simple():
    return 42
', 'interrupt.py');

string sub run_loop(string func, Queue started) {
    try {
        pp.callFunction(func, started);
        return 'returned';
    } catch (hash<ExceptionInfo> ex) {
        return ex.err;
    }
}

int sub simple() {
    return pp.callFunction('simple');
}
", "interrupt");
        # creates the PythonProgram
        p.run();
        SandboxManager sm();
        p.setSandboxManager(sm);

        foreach string func in (("loop", "qore_loop")) {
            Queue started();
            Queue done();
            background done.push(p.callFunction("run_loop", func, started));
            assertEq("in python", started.get(), func);
            sm.requestInterrupt();
            assertEq("PROGRAM-INTERRUPTED", done.get(), func);
            sm.clearInterrupt();
        }
        # the interrupt is not raised later
        assertEq(42, p.callFunction("simple"));
    }

    # a Qore exception raised in a thread created by Python: with Python 3.12, the thread returned to Python with
    # another thread state attached, on which the exception was set (crash: "error return without exception set")
    pythonThreadExceptionTest() {
        if (Python::FreeThreading) {
            testSkip("Python threads in sub-interpreters not supported with free-threading (PEP 703)");
        }
        PythonProgram pp("
import threading
from qore.__root__.Qore.Thread import Counter
res = []
def loop():
    c = Counter(3)
    for i in range(3):
        try:
            c.dec(); c.dec(); c.dec(); c.dec()
        except Exception as e:
            res.append(type(e).__name__)
    res.append(c.getCount())
def run():
    t = threading.Thread(target=loop)
    t.start()
    t.join()
    return res
", "thread_exception.py");
        assertEq(("QoreException", "QoreException", "QoreException", 0), pp.callFunction("run"));
    }

    # interrupts requested while a thread created by Python calls Qore methods: each call creates a helper with the GIL
    # held, which registers the interrupt callback; the helper waited for a callback that waited for the GIL
    # (deadlock)
    interruptPythonThreadTest() {
        if (Python::FreeThreading) {
            testSkip("Background threads with Python not supported with free-threading (PEP 703)");
        }
        Program pgm(PO_NEW_STYLE | PO_STRICT_ARGS | PO_REQUIRE_TYPES);
        pgm.loadModule("python");
        pgm.parse("
our PythonProgram pp('
import threading
from qore.__root__.Qore.Thread import Counter
done = threading.Event()
stats = {\"calls\": 0, \"interrupted\": 0}
def loop():
    c = Counter()
    while not done.is_set():
        try:
            c.getCount()
            stats[\"calls\"] += 1
        except BaseException:
            stats[\"interrupted\"] += 1
t = None
def start():
    global t
    t = threading.Thread(target=loop)
    t.start()
def stop():
    done.set()
    t.join()
    return stats
', 'interrupt_thread.py');
sub start() { pp.callFunction('start'); }
hash<auto> sub stop() { return pp.callFunction('stop'); }
", "interrupt_thread");
        pgm.run();
        SandboxManager sm();
        pgm.setSandboxManager(sm);
        pgm.callFunction("start");
        date end = now_us() + 3s;
        int requests = 0;
        while (now_us() < end) {
            sm.requestInterrupt();
            sm.clearInterrupt();
            ++requests;
        }
        hash<auto> stats = pgm.callFunction("stop");
        assertGt(0, requests);
        assertGt(0, stats.calls);
        assertGt(0, stats.interrupted);
    }

    # deleting a PythonProgram while another thread runs its Python code interrupts the code, so that the deletion does
    # not wait forever; the thread gets PYTHON-INTERPRETER-DELETED
    busyDeleteTest() {
        if (Python::FreeThreading) {
            testSkip("Background threads with Python not supported with free-threading (PEP 703)");
        }
        PythonProgram pp("
def loop(q):
    q.push('in python')
    n = 0
    while True:
        n += 1
", "busy.py");
        Queue started();
        Queue done();
        background sub () {
            try {
                pp.callFunction("loop", started);
                done.push("returned");
            } catch (hash<ExceptionInfo> ex) {
                done.push(ex.err + ": " + ex.desc);
            }
        }();
        assertEq("in python", started.get());
        delete pp;
        assertEq("PYTHON-INTERPRETER-DELETED: the Python program was deleted while the thread ran its Python code",
            done.get());
    }

    sandboxInterruptTest() {
        # Create a sandboxed program that will attempt to call Python after interrupt is requested
        Program p(PO_NEW_STYLE | PO_STRICT_ARGS | PO_REQUIRE_TYPES);
        p.loadModule("python");

        p.parse("
hash<auto> sub test_interrupted_python_call(SandboxManager sm) {
    PythonProgram pp('
def simple_func():
    return 42
', 'simple.py');

    # First call should succeed
    auto first = pp.callFunction('simple_func');

    # Second call should fail because interrupt was requested
    try {
        sm.requestInterrupt();
        auto second = pp.callFunction('simple_func');
        sm.clearInterrupt();
        return {'step': 2, 'first': first, 'error': 'second call did not throw', 'result': second};
    } catch (hash<ExceptionInfo> ex) {
        sm.clearInterrupt();
        return {'step': 2, 'first': first, 'exception': ex};
    }
}
", "test");

        SandboxManager sm();
        p.setSandboxManager(sm);

        auto result = p.callFunction("test_interrupted_python_call", sm);
        assertEq(2, result.step);
        assertEq(42, result.first);
        assertTrue(result.hasKey("exception"));
        assertEq("PROGRAM-INTERRUPTED", result.exception.err);
        assertRegex("Python GIL", result.exception.desc);
    }

