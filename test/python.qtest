import atexit
import gc
import weakref

class Cycle:
    pass

def configure(path):
    def record(value):
        with open(path, 'a', encoding='utf-8') as stream:
            stream.write(value + '\\n')
    # A cyclic object tests weakref finalization as well as explicit atexit hooks.
    item = Cycle()
    item.self = item
    weakref.finalize(item, record, 'weakref')
    gc.collect()
    atexit.register(record, 'atexit')

def echo(value):
    return value
", "finalization.py");
            p.callFunction("configure", output.path);
            if (!Python::FreeThreading) {
                ThreadPool pool();
                on_exit pool.stopWait();
                Queue values();
                for (int value = 0; value < 4; ++value) {
                    # Capture a separate value for each submitted task.
                    int input = value;
                    pool.submit(sub() {
                        values.push(p.callFunction("echo", input));
                    });
                }
                pool.stopWait();
                list<int> received;
                for (int value = 0; value < 4; ++value) {
                    received += values.get();
                }
                assertEq((0, 1, 2, 3), sort(received));
            }
            delete p;
            assertEq("atexit\nweakref\n", output.file.read(-1));
        }
    }

