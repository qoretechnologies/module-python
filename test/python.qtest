import gc

saved = None
def accept(obj):
    global saved
    saved = obj
    gc.collect()
    return obj.value(), type(obj).__module__, gc.is_tracked(obj)

def value():
    return saved.value()

def get():
    return saved
", "cross-interpreter-receiver.py");
