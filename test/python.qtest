    heapTypeReferenceTest() {
        PythonProgram p("
import gc
import sys
from qore.__root__.Qore.Thread import Counter

class DerivedCounter(Counter):
    pass

def delta(cls):
    gc.collect()
    before = sys.getrefcount(cls)
    for _ in range(20):
        # Exercise allocation/deallocation without creating a Qore object whose
        # explicit cross-language lifetime would retain the Python instance.
        obj = cls.__new__(cls)
        assert isinstance(obj, cls)
        assert gc.is_tracked(obj)
        del obj
    gc.collect()
    return sys.getrefcount(cls) - before

def test():
    return delta(Counter), delta(DerivedCounter)
", "heap-type-references.py");
