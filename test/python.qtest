        assertEq(17, obj.value());
        assertEq(17, callback());
        delete owner;
        assertRegex("^((object\ncallable\n)|(callable\nobject\n))$", output.file.read(-1));
        assertThrows("PYTHON-INTERPRETER-DELETED", sub() { obj.value(); });
        assertThrows("PYTHON-INTERPRETER-DELETED", sub() { callback(); });
        delete obj;
        callback = NOTHING;
    }

