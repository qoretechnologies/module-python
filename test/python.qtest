    dateRangeTest() {
        PythonProgram p("
def echo(v):
    return v
", "date-range-test");

        # in-range date/time values must round-trip unchanged; note that datetime.datetime values created
        # from Qore dates are naive (the time zone is dropped), so a local date/time value is used here
        date in_range = 2024-12-25T12:00:00;
        assertEq(in_range, p.callFunction("echo", in_range));
        assertEq((1, in_range), p.callFunction("echo", (1, in_range)));
        assertEq({"k": in_range}, p.callFunction("echo", {"k": in_range}));

        # date/time values outside the range supported by datetime.datetime (year 1 - 9999) have no Python
        # representation; the conversion must raise a Qore exception
        # NOTE: DateTime::getYear() returns a short, so years outside the range of a 16-bit integer used to be
        # silently truncated; 67506 truncated to a short is 1970 and 65537 is 1, both of which are accepted by
        # datetime.datetime, meaning that these values were silently converted to the wrong date
        foreach string ds in (("171978-04-10T12:04:02Z", "67506-01-01T00:00:00Z", "65537-06-15T10:20:30Z")) {
            date d = date(ds);
            assertThrows("builtins.ValueError", \p.callFunction(), ("echo", d), "scalar " + ds);
            assertThrows("builtins.ValueError", \p.callFunction(), ("echo", (1, d)), "list " + ds);
            assertThrows("builtins.ValueError", \p.callFunction(), ("echo", {"k": d}), "hash " + ds);
        }
    }

