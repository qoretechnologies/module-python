        # the constructor, destructor and copy method of a Qore class are not Python methods, for user and builtin
        # classes; calling them ran the destructor's code without destroying the object or crashed (issue 5522)
        PythonProgram sp("
from qore.__root__ import PythonSpecialMethods
from qore.__root__.Qore.Thread import Counter
import copy

def attrs(o):
    return [n for n in ('constructor', 'destructor', 'copy', 'get') if hasattr(o, n)]

def check():
    o = PythonSpecialMethods()
    c = Counter(1)
    rv = {
        'user': attrs(o),
        'user type': attrs(PythonSpecialMethods),
        'user dir': [n for n in dir(o) if n in ('constructor', 'destructor', 'copy')],
        'builtin': attrs(c),
        'get': o.get(),
    }
    try:
        copy.copy(o)
        rv['copy.copy'] = 'copied'
    except TypeError:
        rv['copy.copy'] = 'TypeError'
    return rv
", "special-methods.py");
        int destroyed = PythonSpecialMethods::destroyed;
        hash<auto> h = sp.callFunction("check");
        assertEq(("get",), h."user");
        assertEq(("get",), h."user type");
        assertEq((), h."user dir");
        assertEq((), h.builtin);
        assertEq("get", h.get);
        assertEq("TypeError", h."copy.copy");
        assertEq(0, PythonSpecialMethods::copied);
        assertEq(destroyed + 1, PythonSpecialMethods::destroyed, "the destructor ran once");

        # Qore's exit() is not shadowed by the exit object of Python's builtins, which has no constants in Qore
        Program pgm(PO_NEW_STYLE);
