class SubApi {
    public {
        TestApi parent;
    }

    constructor(TestApi parent) {
        self.parent = parent;
    }

    int callback(string msg) {
        return callbackImpl(msg);
    }

    abstract int callbackImpl(string msg);
}

class TestApi {
    SubApi get() {
        return getImpl();
    }

    int process(string msg) {
        return msg.size();
    }

    abstract SubApi getImpl();
}

