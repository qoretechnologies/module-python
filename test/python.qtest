    # Qore code calls Python functions and methods with keyword arguments; keyword arguments in calls from Python to
    # Qore code, which takes positional arguments, raise TypeError instead of being ignored
    keywordArgumentTest() {
        PythonProgram p("
from qore.__root__.Qore.Thread import Mutex
from qore import sprintf

def f(a, b=2, *, c=3):
    return [a, b, c]

class K:
    @staticmethod
    def s(a, b=2):
        return [a, b]

def type_error(f):
    try:
        f()
    except TypeError as e:
        return str(e)

def callable_kw(f):
    return type_error(lambda: f(1, extra=2))

def constructor_kw():
    return type_error(lambda: Mutex(bogus=1))

def function_kw():
    return type_error(lambda: sprintf('%d', 1, extra=2))

def method_kw():
    return type_error(lambda: Mutex().lock(timeout=1))

class Named(Mutex):
    def __init__(self, name=None):
        super().__init__()
        self.name = name

class Plain(Mutex):
    pass

def subclass_kw():
    return [Named(name='n').name, type_error(lambda: Plain(bogus=1))]
", "kw.py");

        # Qore -> Python
        assertEq((1, 3, 4), p.callFunctionArgs("f", 1, {"b": 3, "c": 4}));
        assertEq((5, 2, 3), p.callFunctionArgs("f", NOTHING, {"a": 5}));
        assertEq((1, 2, 9), p.callFunctionArgs(function_name: "f", arguments: (1,), keyword_arguments: {"c": 9}));
        assertEq((1, 2, 3), p.callFunctionArgs("f", 1, {}));
        assertEq((1, 7), p.callMethodArgs("K", "s", 1, {"b": 7}));
        assertEq((1, 8), p.callMethodArgs(class_name: "K", method_name: "s", arguments: 1,
            keyword_arguments: {"b": 8}));
        assertThrows("builtins.TypeError", "unexpected keyword argument 'zz'", \p.callFunctionArgs(), ("f", 1,
            {"zz": 1}));
        assertThrows("builtins.TypeError", "multiple values for argument 'b'", \p.callFunctionArgs(), ("f", (1, 2),
            {"b": 1}));
        int i = 1;
        assertThrows("PYTHON-VALUE-ERROR", "while converting the keyword arguments", \p.callFunctionArgs(),
            ("f", 1, {"b": \i}));

        # Python -> Qore
        *list<auto> args;
        bool called = False;
        assertEq("a Qore callable takes no keyword arguments",
            p.callFunction("callable_kw", sub () { called = True; args = argv; }));
        # the callable was not called
        assertFalse(called);
        assertEq(NOTHING, args);
        assertEq("qore.Thread.Mutex() takes no keyword arguments", p.callFunction("constructor_kw"));
        assertRegex("takes no keyword arguments", p.callFunction("function_kw"));
        assertRegex("takes no keyword arguments", p.callFunction("method_kw"));
        # a Python subclass of a Qore class takes the keyword arguments of its __init__()
        assertEq(("n", "Plain() takes no keyword arguments"), p.callFunction("subclass_kw"));
    }

    # Python class methods are static methods bound to the class they are called for; methods that are not methods
    # of the Qore class (callable attributes of the object, methods added to the class later) are called as Python
    # gets them from the object, with all their arguments; all the base classes of a Python class are its Qore parents
    pythonClassTest() {
        PythonProgram p("
import functools

class A:
    def __init__(self):
        self.v = 1
        self.cb = lambda x: x + 1
        self.part = functools.partial(lambda a, b: [a, b], 'p')
        self.notcallable = 5
    @classmethod
    def cm(cls, v):
        return [cls.__name__, v * 2]
    @classmethod
    def make(cls):
        return cls()
    @property
    def broken(self):
        raise ValueError('broken property')

class B(A):
    pass

class M1:
    def m1(self):
        return 'm1'
    @classmethod
    def mixin_cm(cls):
        return cls.__name__

class C(B, M1):
    @classmethod
    def cm(cls, v):
        return ['C.cm', v]

def get(name):
    return globals()[name]()

def patch():
    A.late = lambda self, *args: ['late', list(args)]
", "classes.py");

        object a = p.callFunction("get", "A");
        object b = p.callFunction("get", "B");
        object c = p.callFunction("get", "C");

        # class methods get the class of the object; inherited ones get the subclass
        assertEq(("A", 6), a.cm(3));
        assertEq(("B", 8), b.cm(4));
        assertEq(("C.cm", 5), c.cm(5));
        assertEq("C", c.mixin_cm());
        object made = b.make();
        assertEq("B", made.className());

        # callable attributes of the object
        assertEq(2, a.cb(1));
        assertEq(("p", "q"), a.part("q"));
        # (closures: call references to methods that are not methods of the Qore class cannot be created)
        assertThrows("METHOD-DOES-NOT-EXIST", "'notcallable' of the Python value of type 'A' is not callable",
            sub () { a.notcallable(); });
        assertThrows("METHOD-DOES-NOT-EXIST", "has no method or member 'nosuch'", sub () { a.nosuch(); });
        # an exception other than AttributeError raised when getting the attribute is raised
        assertThrows("builtins.ValueError", "broken property", sub () { a.broken(); });

        # a method added to the class after its Qore class was created gets all its arguments
        p.callFunction("patch");
        assertEq(("late", (1, 2, 3)), a.late(1, 2, 3));
        assertEq(("late", ()), a.late());

        # all the base classes are parents of the Qore class
        assertEq(("B", "M1"), (map $1.cls.getName(), Class::getClass(c).getParentClasses())[0..1]);
        assertEq("m1", c.m1());

        # a class method of a class exported to a Qore Program
        Program pgm(PO_NEW_STYLE);
        pgm.issueModuleCmd("python", "parse class_test.py #
class Base:
    @classmethod
    def make(cls):
        return cls()
    @classmethod
    def name(cls):
        return cls.__name__
class Sub(Base):
    pass
");
        pgm.issueModuleCmd("python", "export-class Base");
        pgm.issueModuleCmd("python", "export-class Sub");
        pgm.parse("
string sub base_name() { return Base::name(); }
string sub sub_name() { return Sub::name(); }
string sub made_name() { return Sub::make().name(); }
", "class_test");
        assertEq("Base", pgm.callFunction("base_name"));
        assertEq("Sub", pgm.callFunction("sub_name"));
        assertEq("Sub", pgm.callFunction("made_name"));
    }

    classNamespaceTest() {
        foreach bool abc_first in (False, True) {
            Program p(PO_NEW_STYLE);
            p.loadModule("python");
            if (abc_first) {
                p.issueModuleCmd("python", "import collections.abc.Iterable");
                p.issueModuleCmd("python", "import collections.abc.MutableMapping");
            }
            p.issueModuleCmd("python", "import os");
            foreach string name in ("Iterable", "MutableMapping") {
                string path = "Python::collections::abc::" + name;
                assertEq(path, Class::forName(p, path).getPathName());
                assertThrows("UNKNOWN-CLASS", \Class::forName(), (p, "Python::os::" + name));
            }
            Class env = Class::forName(p, "Python::os::_Environ");
            assertEq("Python::collections::abc::MutableMapping", env.getParentClasses()[0].cls.getPathName());
            p.issueModuleCmd("python", "import collections.abc.MutableMapping");
            assertEq("Python::collections::abc::MutableMapping", env.getParentClasses()[0].cls.getPathName());
            assertEq(Type::String, p.callFunction("Python::os::getcwd").type());
            p.issueModuleCmd("python", "import _io.BytesIO");
            assertEq("Python::_io::BytesIO", Class::forName(p, "Python::_io::BytesIO").getPathName());
        }

        # Two importing modules share classes defined in a nested module; explicit re-exports and instances must
        # resolve to the same class, while functions and constants remain in the importing module's namespace.
        foreach bool reverse in (False, True) {
            Program p(PO_NEW_STYLE);
            p.issueModuleCmd("python", "parse namespace_fixture.py #
import sys, types
owner = types.ModuleType('qore_ns_owner.deep')
exec('''
class Shared:
    def value(self):
        return 42
class Mixin:
    def mixin(self):
        return 7
def get_shared():
    return Shared()
''', owner.__dict__)
for module_name, child_name in (('qore_ns_first', 'ChildA'), ('qore_ns_second', 'ChildB')):
    mod = types.ModuleType(module_name)
    child = type(child_name, (owner.Shared, owner.Mixin), {'__module__': module_name})
    setattr(mod, child_name, child)
    mod.Alias = owner.Shared
    mod.get_shared = owner.get_shared
    mod.VALUE = 19
    mod.instance = owner.Shared()
    mod.Fallback = type('Fallback', (), {'__module__': None})
    mod.__all__ = [child_name, 'Alias', 'get_shared', 'VALUE', 'instance', 'Fallback']
    sys.modules[module_name] = mod

class Explicit:
    pass
");
            foreach string mod in (reverse ? ("qore_ns_second", "qore_ns_first")
                    : ("qore_ns_first", "qore_ns_second")) {
                p.issueModuleCmd("python", "import " + mod);
            }
            foreach string path in ("Python::qore_ns_first::ChildA", "Python::qore_ns_second::ChildB") {
                list<string> parents = (map cast<Class>($1.cls).getPathName(),
                    Class::forName(p, path).getParentClasses())[0..1];
                assertEq(("Python::qore_ns_owner::deep::Shared", "Python::qore_ns_owner::deep::Mixin"), parents);
            }
            p.parse("bool sub shared_instance() { return Python::qore_ns_first::instance instanceof "
                "Python::qore_ns_owner::deep::Shared; }", "namespace-identity");
            assertTrue(p.callFunction("shared_instance"));
            foreach string mod in ("qore_ns_first", "qore_ns_second") {
                assertEq("Python::" + mod + "::Fallback", Class::forName(p,
                    "Python::" + mod + "::Fallback").getPathName());
                assertThrows("UNKNOWN-CLASS", \Class::forName(), (p, "Python::" + mod + "::Shared"));
                assertThrows("UNKNOWN-CLASS", \Class::forName(), (p, "Python::" + mod + "::Alias"));
                object o = p.callFunction("Python::" + mod + "::get_shared");
                assertEq("Python::qore_ns_owner::deep::Shared", Class::getClass(o).getPathName());
                assertEq(42, o.value());
                assertEq(19, p.getExpression("Python::" + mod + "::VALUE", "namespace-constant").eval());
                object instance = p.getExpression("Python::" + mod + "::instance", "namespace-instance").eval();
                assertEq("Python::qore_ns_owner::deep::Shared", Class::getClass(instance).getPathName());
                # Release the imported object's Python private data while its Program is still alive.
                delete instance;
            }
            p.issueModuleCmd("python", "export-class Explicit");
            assertEq("Explicit", Class::forName(p, "Explicit").getPathName());
        }
    }

    classNamespaceMetadataTest() {
        PythonProgram p("
class Meta(type):
    def __getattribute__(cls, name):
        if name == '__module__':
            mode = type.__getattribute__(cls, 'mode')
            if mode == 'missing':
                raise AttributeError('no module')
            if mode == 'error':
                raise ValueError('module lookup failed')
            if mode == 'surrogate':
                return '\\ud800'
            if mode == 'nul':
                return 'owner\\x00hidden'
            if mode == 'empty':
                return ''
            if mode == 'number':
                return 42
            return None
        return type.__getattribute__(cls, name)

def make(mode):
    cls = Meta('Metadata_' + mode, (), {'mode': mode})
    return cls()

def legacy_name():
    return Meta('qore_ns_legacy.deep.Legacy', (), {'mode': 'missing'})()

class Dotted:
    pass
Dotted.__name__ = 'misleading.Dotted'
Dotted.__module__ = 'qore_ns_real.owner'
def dotted():
    return Dotted()

broken = True
class BaseMeta(type):
    def __getattribute__(cls, name):
        if name == '__module__' and type.__getattribute__(cls, '__name__') == 'BrokenBase' and broken:
            raise ValueError('base module lookup failed')
        return type.__getattribute__(cls, name)
class BrokenBase(metaclass=BaseMeta):
    __module__ = 'qore_ns_retry'
    def value(self):
        return 42
class RetryChild(BrokenBase):
    __module__ = 'qore_ns_retry'
def retry_child(repair=False):
    global broken
    if repair:
        broken = False
    return RetryChild()
", "namespace_metadata.py");
        foreach string mode in ("missing", "none", "empty", "number") {
            object o = p.callFunction("make", mode);
            assertEq("Python::Metadata_" + mode, Class::getClass(o).getPathName());
        }
        assertThrows("builtins.ValueError", "module lookup failed", \p.callFunction(), ("make", "error"));
        assertThrows("builtins.UnicodeEncodeError", "surrogates not allowed", \p.callFunction(),
            ("make", "surrogate"));
        assertThrows("PYTHON-IMPORT-ERROR", "contains a null byte", \p.callFunction(), ("make", "nul"));
        object dotted = p.callFunction("dotted");
        assertEq("Python::qore_ns_real::owner::Dotted", Class::getClass(dotted).getPathName());
        object legacy = p.callFunction("legacy_name");
        assertEq("Python::qore_ns_legacy::deep::Legacy", Class::getClass(legacy).getPathName());
        # A failed parent lookup must not leave an incomplete subclass in either class cache.
        for (int i = 0; i < 2; ++i) {
            assertThrows("builtins.ValueError", "base module lookup failed", \p.callFunction(), "retry_child");
        }
        object repaired = p.callFunction("retry_child", True);
        assertEq("Python::qore_ns_retry::RetryChild", Class::getClass(repaired).getPathName());
        assertEq("Python::qore_ns_retry::BrokenBase",
            Class::getClass(repaired).getParentClasses()[0].cls.getPathName());
        assertEq(42, repaired.value());
    }

    # assigning a member of the Qore object of a Python object sets the Python attribute; removing or deleting the
    # member deletes it
    attributeWriteTest() {
        PythonProgram p("
class A:
    def __init__(self):
        self.v = 1
        self.d = {'a': 1}
        self.l = [1, 2]
        self._p = 0
    def attrs(self):
        return sorted(k for k in vars(self) if k != '_p')
    def has(self, name):
        return hasattr(self, name)
    def peek(self, name):
        return getattr(self, name)
    @property
    def prop(self):
        return self._p
    @prop.setter
    def prop(self, value):
        if value < 0:
            raise ValueError('negative value')
        self._p = value * 2
    @prop.deleter
    def prop(self):
        self._p = -1
    @property
    def ro(self):
        return 'read-only'

class S:
    __slots__ = ('a', 'b')
    def __init__(self):
        self.a = 1
    def has(self, name):
        return hasattr(self, name)

class Frozen:
    def __setattr__(self, name, value):
        raise TypeError('frozen: ' + name)
    def __delattr__(self, name):
        raise TypeError('frozen: ' + name)

class Counter:
    def __init__(self):
        self.n = 0
        self.writes = 0
    def __setattr__(self, name, value):
        if name == 'n':
            object.__setattr__(self, 'writes', getattr(self, 'writes', 0) + 1)
        object.__setattr__(self, name, value)

def get(name):
    return globals()[name]()
", "attrs.py");

        object a = p.callFunction("get", "A");
        # a new attribute and a changed attribute
        a.w = "new";
        a.v = 10;
        assertEq("new", a.peek("w"));
        assertEq(10, a.peek("v"));
        assertEq(("d", "l", "v", "w"), a.attrs());
        # values are converted to Python values
        a.h = {"x": (1, 2)};
        assertEq({"x": (1, 2)}, a.peek("h"));
        assertEq({"x": (1, 2)}, a.h);
        # compound assignments read the attribute and write the result
        a.v += 5;
        assertEq(15, a.peek("v"));
        a.v *= 2;
        assertEq(30, a.v);
        a.w += "er";
        assertEq("newer", a.peek("w"));
        # changing a container writes it back
        a.d.b = 2;
        assertEq({"a": 1, "b": 2}, a.peek("d"));
        a.l += 3;
        assertEq((1, 2, 3), a.peek("l"));
        push a.l, 4;
        assertEq((1, 2, 3, 4), a.peek("l"));
        # through a reference to the member
        {
            reference<auto> r = \a.v;
            r = 7;
        }
        assertEq(7, a.peek("v"));
        # a dynamic member name
        string name = "dyn";
        a{name} = True;
        assertTrue(a.peek("dyn"));

        # remove returns the previous value and deletes the attribute
        assertEq("newer", remove a.w);
        assertFalse(a.has("w"));
        # removing a missing attribute returns no value
        assertEq(NOTHING, remove a.nosuch);
        delete a.dyn;
        assertFalse(a.has("dyn"));
        assertEq(("d", "h", "l", "v"), a.attrs());

        # data descriptors are used as in Python
        a.prop = 4;
        assertEq(8, a.prop);
        assertEq(8, a.peek("_p"));
        assertThrows("builtins.ValueError", "negative value", sub () { a.prop = -1; });
        assertEq(8, a.prop);
        assertEq(8, remove a.prop);
        assertEq(-1, a.peek("_p"));
        assertThrows("builtins.AttributeError", "ro", sub () { a.ro = 1; });
        assertEq("read-only", a.ro);

        # __slots__
        object s = p.callFunction("get", "S");
        s.b = 2;
        assertEq(2, s.b);
        assertTrue(s.has("b"));
        assertEq(1, remove s.a);
        assertFalse(s.has("a"));
        assertThrows("builtins.AttributeError", "c", sub () { s.c = 3; });

        # __setattr__() and __delattr__() are called
        object f = p.callFunction("get", "Frozen");
        assertThrows("builtins.TypeError", "frozen: x", sub () { f.x = 1; });
        object c = p.callFunction("get", "Counter");
        c.n += 1;
        c.n = 5;
        assertEq(5, c.n);
        assertEq(2, c.writes);

        # an object of a Python class exported to a Program and of a Qore subclass
        Program pgm(PO_NEW_STYLE | PO_STRICT_ARGS | PO_REQUIRE_TYPES);
        pgm.issueModuleCmd("python", "parse attr_test.py #
class Base:
    def __init__(self):
        self.tag = 'base'
    def show(self):
        return [self.tag, getattr(self, 'extra', None)]
");
        pgm.issueModuleCmd("python", "export-class Base");
        pgm.parse("
class Q inherits Base {
    list<auto> update() {
        self.tag = 'updated';
        self.extra = 1;
        self.extra += 1;
        return show();
    }
}
list<auto> sub base() {
    Base b();
    b.tag = 'set';
    b.extra = 2;
    return b.show();
}
object sub new_q() { return new Q(); }
", "attr_test");
        assertEq(("set", 2), pgm.callFunction("base"));
        object q = pgm.callFunction("new_q");
        assertEq("base", q.tag);
        assertEq(("updated", 2), q.update());
        q.extra = "from outside";
        assertEq(("updated", "from outside"), q.show());
        assertEq("from outside", remove q.extra);
        assertEq(("updated", NOTHING), q.show());
    }

    # a Qore class that inherits a Python class can be imported into Python (ex: import-ns): its Python type is the
    # type of a Qore class (a Python type cannot be the base class of such a type); previously the import crashed
    # (the result of PyType_FromSpecWithBases() was not checked) (issue 5522)
    qoreSubclassImportTest() {
        Program pgm(PO_NEW_STYLE);
        pgm.issueModuleCmd("python", "parse subclass_import.py #
class Base:
    def hook(self):
        return 'python-hook'
    def base_only(self):
        return 'base-only:' + self.hook()
");
        pgm.issueModuleCmd("python", "export-class Base");
        pgm.parse("our auto saved;
namespace SubclassImport {
    class Q inherits Base {
        string hook() { return 'qore-hook'; }
        string qm() { return 'qm'; }
    }
    public sub save(auto v) { saved = v; }
}
", "subclass-import");
        pgm.issueModuleCmd("python", "import-ns SubclassImport si");
        pgm.issueModuleCmd("python", "parse subclass_import_check.py #
q = si.Q()
si.save({'type': type(q).__name__, 'hook': q.hook(), 'qm': q.qm(), 'base_only': q.base_only(),
    'isinstance': isinstance(q, si.Q)})
");
        assertEq({"type": "Q", "hook": "qore-hook", "qm": "qm", "base_only": "base-only:qore-hook",
            "isinstance": True}, pgm.getGlobalVariable("saved"));
    }

    # the Python object of a Qore object whose class inherits a Python class is an object of a generated subclass
    # whose methods that the Qore class overrides call the Qore methods, so that Python code calls the Qore overrides
    qoreOverrideTest() {
        Program pgm(PO_NEW_STYLE);
        pgm.issueModuleCmd("python", "parse override_test.py #
class Base:
    def __init__(self, tag='base'):
        self.tag = tag
        self.init_hook = self.hook()
    def run(self, x):
        return 'run:' + self.hook() + ':' + str(self.calc(x))
    def hook(self):
        return 'python-hook'
    def calc(self, x):
        return x
    def fail(self):
        return self.raising()
    def raising(self):
        return 'python'
    def copy(self):
        return 'python-copy'
    def use_copy(self):
        return self.copy()
    def secret(self):
        return 'python-secret'
    def use_secret(self):
        return self.secret()
    def me(self):
        return self
    def get(self, name):
        return getattr(self, name)

class Slotted:
    __slots__ = ('a',)
    def run(self):
        return 'slotted:' + self.hook()
    def hook(self):
        return 'python'

class Tup(tuple):
    __slots__ = ()
    def run(self):
        return self.hook()
    def hook(self):
        return 'python'

saved = []
def save(obj):
    saved.append(obj)
def call_saved():
    return saved.pop().hook()
");
        foreach string c in (("Base", "Slotted", "Tup")) {
            pgm.issueModuleCmd("python", "export-class " + c);
        }
        pgm.issueModuleCmd("python", "export-func save");
        pgm.issueModuleCmd("python", "export-func call_saved");
        pgm.parse("
class Q inherits Base {
    string hook() { return 'qore-hook'; }
    int calc(int x) { return x * 10; }
    string raising() { throw 'QORE-ERR', 'from qore'; }
    string _copy() { return 'qore-copy'; }
    private string secret() { return 'qore-secret'; }
}
class R inherits Q {
    string hook() { return 'r-hook:' + Q::hook(); }
}
class Super inherits Base {
    string hook() { return 'super:' + Base::hook(); }
}
class S inherits Slotted {
    string hook() { return 'qore'; }
}
class T inherits Tup {
    string hook() { return 'qore'; }
}
object sub new_q() { return new Q(); }
object sub new_r() { return new R(); }
object sub new_super() { return new Super(); }
object sub new_s() { return new S(); }
object sub new_t() { return new T(); }
", "override_test");

        object q = pgm.callFunction("new_q");
        assertEq("qore-hook", q.hook());
        # Python code calls the Qore overrides, with arguments and results converted
        assertEq("run:qore-hook:50", q.run(5));
        # also from __init__()
        assertEq("qore-hook", q.init_hook);
        assertEq("base", q.tag);
        # a Qore exception raised by an override passes through the Python code
        assertThrows("QORE-ERR", "from qore", \q.fail());
        # methods with special names in Qore (copy() is _copy() in Qore)
        assertEq("qore-copy", q.use_copy());
        # private Qore methods do not override Python methods
        assertEq("python-secret", q.use_secret());
        # the Python object is the Qore object in Qore
        assertTrue(q.me() == q);

        # a subclass of the Qore class: its own overrides
        object r = pgm.callFunction("new_r");
        assertEq("run:r-hook:qore-hook:30", r.run(3));
        # an override calling the Python method of the base class
        object sup = pgm.callFunction("new_super");
        assertEq("run:super:python-hook:1", sup.run(1));

        # a Python class with __slots__
        object s = pgm.callFunction("new_s");
        assertEq("slotted:qore", s.run());

        # a Python class whose objects cannot have the slot before Python 3.15 (a subclass of tuple, a variable-size
        # type)
        if (PythonProgram::evalExpression("__import__('sys').version_info >= (3, 15)")) {
            object t = pgm.callFunction("new_t");
            assertEq("qore", t.run());
        } else {
            assertThrows("builtins.TypeError", "while creating the Python type of Qore class 'T'",
                \pgm.callFunction(), "new_t");
        }

        # an override called on a Qore object that was deleted
        {
            object q1 = pgm.callFunction("new_q");
            pgm.callFunction("save", q1);
            delete q1;
        }
        assertThrows("OBJECT-ALREADY-DELETED", \pgm.callFunction(), "call_saved");
    }

    # the Python objects of a Program (ex: objects of a Python subclass of one of its classes kept by Python code) are
    # released while the Program is still valid, so that the destructors of their Qore objects run in it: they ran
    # after the Program was deleted (PROGRAM-ERROR); run in another process, as the error is printed by the destructor
    programCleanupTest() {
        TmpDir tmp("python-cleanup-");
        string script = tmp.path + "/cleanup.q";
        File f();
        f.open2(script, O_WRONLY | O_CREAT | O_TRUNC);
        f.write("%modern
%requires python
namespace CleanupTest {
    class Tracked {
        destructor() {
            printf(\"destructor ran\\n\");
        }
    }
}
{
    Program p(PO_NEW_STYLE);
    p.importClass(\"CleanupTest::Tracked\");
    p.issueModuleCmd(\"python\", \"import-ns CleanupTest x\");
    p.issueModuleCmd(\"python\", \"parse cleanup.py import qoreloader\\nkeep = []\\n\"
        \"class PyTracked(x.Tracked):\\n    pass\\ndef make():\\n    keep.append(PyTracked())\\n\");
    p.issueModuleCmd(\"python\", \"export-func make\");
    p.parse(\"sub run() { make(); }\", \"cleanup\");
    p.callFunction(\"run\");
}
printf(\"done\\n\");
");
        f.close();
        string output = backquote(sprintf("qore %s 2>&1", script));
        assertEq("destructor ran\ndone\n", output);
    }

    # the Python types of the classes, hashdecls and enums of a Program can outlive it: they raise a RuntimeError when
    # they are used after the Program has been deleted, and the declarations of a new Program get new types
    declarationLifetimeTest() {
        PythonProgram pp("
saved = {}
def save_hash(h):
    saved['hash'] = h
    saved['hash_type'] = type(h)
def save_enum(e):
    saved['enum'] = e
def save_class(o):
    t = type(o)
    saved['obj_type'] = t
    saved['meth'] = t.get
def make_hash():
    return saved['hash_type'](a=2)
def get_hash():
    return saved['hash']
def get_enum():
    return saved['enum']
def construct():
    return saved['obj_type']().get()
def call_method():
    return saved['meth'](None)
def static_method():
    return saved['obj_type'].smeth()
def get_static():
    return saved['obj_type'].smem
def set_static(v):
    # the descriptor sets the member; assigning to the attribute of the class would replace it
    saved['obj_type'].__dict__['smem'].__set__(None, v)
def subclass():
    class Sub(saved['obj_type']):
        pass
    return Sub()
", "decl_lifetime.py");

        string child_src = "class ChildClass {
    public {
        static int smem = 5;
    }
    int get() {
        return 1;
    }
    static int smeth() {
        return 3;
    }
}
enum ChildEnum {
    A = 1,
    B = 2,
}
hashdecl ChildHash {
    int a = 0;
    int b = 4;
}
hash<ChildHash> sub get_hash() {
    return <ChildHash>{\"a\": 1};
}
ChildEnum sub get_enum() {
    return ChildEnum::B;
}
bool sub is_b(ChildEnum e) {
    return e == ChildEnum::B;
}
ChildClass sub get_object() {
    return new ChildClass();
}
";

        # the types of a Program's declarations are made and used while it is valid
        code check_child = sub () {
            Program child(PO_NEW_STYLE);
            child.parse(child_src, "child");
            pp.callFunction("save_hash", child.callFunction("get_hash"));
            pp.callFunction("save_enum", child.callFunction("get_enum"));
            pp.callFunction("save_class", child.callFunction("get_object"));

            hash<auto> h = pp.callFunction("make_hash");
            assertEq("hash<ChildHash>", h.fullType());
            assertEq({"a": 2, "b": 4}, h);
            h = pp.callFunction("get_hash");
            assertEq("hash<ChildHash>", h.fullType());
            assertEq({"a": 1, "b": 4}, h);
            auto e = pp.callFunction("get_enum");
            assertEq("enum<ChildEnum>", e.fullType());
            assertTrue(child.callFunction("is_b", e));
            assertEq(1, pp.callFunction("construct"));
            assertEq(3, pp.callFunction("static_method"));
            assertEq(5, pp.callFunction("get_static"));
            pp.callFunction("set_static", 7);
            assertEq(7, pp.callFunction("get_static"));
            assertEq(7, child.callFunction("call_static"));
        };
        child_src += "int sub call_static() { return ChildClass::smem; }\n";
        check_child();

        # the Program has been deleted
        string err = "builtins.RuntimeError";
        string desc = "the Qore Program that declared it has been deleted";
        assertThrows(err, "Qore hashdecl 'ChildHash' cannot be used: " + desc, \pp.callFunction(), "make_hash");
        assertThrows(err, "Qore hashdecl 'ChildHash' cannot be used: " + desc, \pp.callFunction(), "get_hash");
        assertThrows(err, "Qore enum 'ChildEnum' cannot be used: " + desc, \pp.callFunction(), "get_enum");
        assertThrows(err, "Qore class 'ChildClass' cannot be used: " + desc, \pp.callFunction(), "construct");
        assertThrows(err, "Qore class 'ChildClass' cannot be used: " + desc, \pp.callFunction(), "call_method");
        assertThrows(err, "Qore class 'ChildClass' cannot be used: " + desc, \pp.callFunction(), "static_method");
        assertThrows(err, "Qore class 'ChildClass' cannot be used: " + desc, \pp.callFunction(), "get_static");
        assertThrows(err, "Qore class 'ChildClass' cannot be used: " + desc, \pp.callFunction(), ("set_static", 1));
        assertThrows(err, "Qore class 'ChildClass' cannot be used: " + desc, \pp.callFunction(), "subclass");

        # the same declarations in a new Program get new types
        check_child();

        # a hashdecl, enum or class that outlives its Program (held by a value) has no Python type, which would outlive
        # it: its hash is a dict, the value of its enum is the member's value, and its object cannot be converted
        hash<auto> h;
        auto e;
        object o;
        {
            Program child(PO_NEW_STYLE);
            child.parse(child_src, "child");
            h = child.callFunction("get_hash");
            e = child.callFunction("get_enum");
            o = child.callFunction("get_object");
        }
        assertEq("hash<ChildHash>", h.fullType());
        # the value keeps its enum (qoretechnologies/qore#5519)
        assertEq("enum<ChildEnum>", e.fullType());
        PythonProgram pp2("saved = []\ndef type_name(v):\n    return type(v).__name__\ndef echo(v):\n    return v\n"
            "def save(v):\n    saved.append(v)\ndef get_saved():\n    return saved[0]\n", "outlived.py");
        assertEq("dict", pp2.callFunction("type_name", h));
        hash<auto> h2 = pp2.callFunction("echo", h);
        assertEq("hash<auto>", h2.fullType());
        assertEq({"a": 1, "b": 4}, h2);
        assertEq("int", pp2.callFunction("type_name", e));
        auto e2 = pp2.callFunction("echo", e);
        assertEq("integer", e2.fullType());
        assertEq(2, e2);
        list<auto> l2 = pp2.callFunction("echo", (e, "x"));
        assertEq((2, "x"), l2);
        assertEq("integer", l2[0].fullType());
        hash<auto> eh2 = pp2.callFunction("echo", {"e": e});
        assertEq({"e": 2}, eh2);
        assertEq("integer", eh2.e.fullType());
        # a Python enum class would outlive the enum once its last Qore value is gone (crashed before)
        pp2.callFunction("save", e);
        remove e;
        auto e3 = pp2.callFunction("get_saved");
        assertEq(2, e3);
        assertEq("integer", e3.fullType());
        assertThrows("PYTHON-VALUE-ERROR", "cannot convert an object of class 'ChildClass' to Python: the Qore Program "
            "that declared the class has been deleted", \pp2.callFunction(), ("type_name", o));
    }

    # the Python object of an object of a Qore class that inherits a Python subclass of a Qore class is the Qore object
    # (another Qore object of the Qore base class was created); the Qore base class is constructed by Qore, so
    # __init__() cannot pass arguments to it
    qorePythonQoreSubclassTest() {
        Program pgm(PO_NEW_STYLE | PO_STRICT_ARGS | PO_REQUIRE_TYPES);
        pgm.loadModule("python");
        pgm.issueModuleCmd("python", "parse qpq_test.py #
from qore.__root__.Qore.Thread import Counter
class PyCounter(Counter):
    def me(self):
        return self
    def py_count(self):
        return self.getCount()
");
        pgm.issueModuleCmd("python", "export-class PyCounter");
        pgm.parse("
class QoreCounter inherits PyCounter {
    int qore_count() { return getCount(); }
}
class QoreCounterArgs inherits PyCounter {
    constructor() : PyCounter(5) {}
}
object sub new_counter() { return new QoreCounter(); }
object sub new_counter_args() { return new QoreCounterArgs(); }
", "qpq_test");
        object c = pgm.callFunction("new_counter");
        assertTrue(c.me() == c);
        c.inc();
        c.inc();
        assertEq(2, c.qore_count());
        assertEq(2, c.py_count());
        assertThrows("builtins.TypeError", "no arguments can be given to its __init__", \pgm.callFunction(),
            "new_counter_args");
    }

    # a Qore object is the same Python object each time it is passed to Python; missing members raise AttributeError,
    # so hasattr() and getattr() with a default work; Python code sets the members of Qore objects (also from Python
    # subclasses), dir() lists the public members, and Qore objects support weak references
    qoreObjectProtocolTest() {
        PythonProgram p("
import weakref
from qore.__root__ import PythonAttrDecl, PythonAttrDyn, PythonAttrGate
from qore.__root__.Qore.Thread import Queue, Mutex

class Sub(PythonAttrDecl):
    def __init__(self):
        super().__init__()
        self.pyattr = 'py'
        self.pub = 5
    @property
    def prop(self):
        return self._p
    @prop.setter
    def prop(self, v):
        self._p = v * 2

class NoInit(PythonAttrDecl):
    def __init__(self):
        pass

def error(f):
    try:
        f()
    except AttributeError as e:
        return str(e)

def identity():
    q = Queue()
    m = Mutex()
    q.push(m)
    a = q.get()
    return [a is m, a == m, hash(a) == hash(m)]

def same(o1, o2):
    return o1 is o2

def run():
    r = {}
    d = PythonAttrDecl()
    r['pub'] = d.pub
    r['opt'] = d.opt
    r['has_nope'] = hasattr(d, 'nope')
    r['getattr_default'] = getattr(d, 'nope', 42)
    r['nope'] = error(lambda: d.nope)
    r['fspath'] = hasattr(d, '__fspath__')
    r['priv_get'] = error(lambda: d.priv)
    d.pub = 10
    r['pub_set'] = d.getPub()
    r['priv_set'] = error(lambda: setattr(d, 'priv', 3))
    r['priv_unchanged'] = d.getPriv()
    r['decl_new'] = error(lambda: setattr(d, 'newmember', 3))
    y = PythonAttrDyn()
    y.x = 7
    r['dyn_x'] = [y.x, y.get('x')]
    del y.x
    r['dyn_del'] = [hasattr(y, 'x'), error(lambda: delattr(y, 'x'))]
    r['gate'] = PythonAttrGate().anything
    s = Sub()
    r['sub_pub'] = s.getPub()
    r['sub_pyattr'] = s.pyattr
    s.prop = 4
    r['sub_prop'] = s.prop
    r['noinit'] = [error(lambda: NoInit().pub), hasattr(NoInit(), 'pub')]
    r['dir'] = ['pub' in dir(d), 'opt' in dir(d), 'priv' in dir(d), 'getPub' in dir(d)]
    w = weakref.ref(d)
    r['weak'] = w() is d
    del d
    r['weak_dead'] = w() is None
    return r
", "objects.py");

        assertEq((True, True, True), p.callFunction("identity"));
        # a Qore object passed twice from Qore is the same Python object
        Mutex m();
        assertTrue(p.callFunction("same", m, m));
        assertFalse(p.callFunction("same", m, new Mutex()));

        hash<auto> r = p.callFunction("run");
        assertEq(1, r.pub);
        assertEq(NOTHING, r.opt);
        assertFalse(r.has_nope);
        assertEq(42, r.getattr_default);
        assertEq("'PythonAttrDecl' object has no attribute 'nope'", r.nope);
        # special names are Python protocols, not Qore members
        assertFalse(r.fspath);
        assertEq("'priv' is a private member of class 'PythonAttrDecl'", r.priv_get);
        assertEq(10, r.pub_set);
        assertEq("'priv' is a private member of Qore class 'PythonAttrDecl'", r.priv_set);
        assertEq(2, r.priv_unchanged);
        assertEq("'newmember' is not a registered member of Qore class 'PythonAttrDecl'", r.decl_new);
        assertEq((7, 7), r.dyn_x);
        assertEq((False, "'PythonAttrDyn' object has no attribute 'x'"), r.dyn_del);
        assertEq("gate-anything", r.gate);
        # the members set by a Python subclass are the Qore object's; other attributes are Python attributes
        assertEq(5, r.sub_pub);
        assertEq("py", r.sub_pyattr);
        assertEq(8, r.sub_prop);
        assertRegex("^'NoInit' object has no attribute 'pub' \\(the object has no Qore object", r.noinit[0]);
        assertFalse(r.noinit[1]);
        assertEq((True, True, False, True), r.dir);
        assertTrue(r.weak);
        assertTrue(r.weak_dead);
    }

    # static members of Qore classes are descriptors of their current values; Qore enums are Python enum classes whose
    # members are the Qore enum values; hashdecls are dict subclasses whose objects are hashes of the hashdecl in Qore
    qoreDeclarationTest() {
        PythonProgram p("
from qore.__root__.PythonDeclTest import Color, Mode, Info, Counter, make_info, check_info, color_val, get_color

def error(f):
    try:
        f()
    except Exception as e:
        return type(e).__name__ + ': ' + str(e)

def run():
    r = {}
    r['static'] = [Counter.count, hasattr(Counter, 'hidden')]
    o = Counter()
    o.count = 5
    r['static_set'] = [Counter.get(), Counter.count, o.count]
    r['color'] = [Color.__mro__[1].__name__, Color.Red == 1, Color['Green'].value, get_color() is Color.Green]
    r['mode'] = [Mode.__mro__[1].__name__, Mode.Fast == 'fast']
    r['color_val'] = color_val(Color.Green)
    r['color_int'] = error(lambda: color_val(2))
    i = Info(a=3)
    r['info'] = [dict(i), type(i).__name__, isinstance(i, dict)]
    m = make_info()
    r['made'] = [type(m).__name__, dict(m)]
    r['check'] = check_info(Info(a=7, b='y'))
    r['check_dict'] = error(lambda: check_info({'a': 8}))
    r['bad_key'] = error(lambda: check_info(Info(zz=1)))
    return r

def static_value():
    return Counter.count
", "decls.py");

        hash<auto> r = p.callFunction("run");
        assertEq((1, False), r.static);
        assertEq((5, 5, 5), r.static_set);
        # the descriptor gives the current value of the static member
        PythonDeclTest::Counter::count = 9;
        assertEq(9, p.callFunction("static_value"));

        assertEq(("IntEnum", True, 2, True), r.color);
        assertEq(("StrEnum", True), r.mode);
        # an enum member is the Qore enum value
        assertEq(2, r.color_val);
        # an int is not a value of the enum, as in Qore
        assertRegex("RUNTIME-OVERLOAD-ERROR", r.color_int);
        # a Qore enum value is the member of the Python enum class
        auto color = p.evalExpression("get_color()");
        assertEq("enum<Color>", color.fullType());
        assertEq(PythonDeclTest::Color::Green, color);

        assertEq(({"a": 3, "b": "x"}, "Info", True), r.info);
        assertEq(("Info", {"a": 5, "b": "x"}), r.made);
        assertEq("hash<Info> 7 y", r.check);
        # a dict is not a hash of the hashdecl, as a hash is not in Qore
        assertRegex("RUNTIME-OVERLOAD-ERROR", r.check_dict);
        assertRegex("HASHDECL-INIT-ERROR.*unknown key 'zz'", r.bad_key);
        # a hash of the hashdecl from Python is a hash of the hashdecl in Qore
        auto info = p.evalExpression("Info(a=11)");
        assertEq("hash<Info>", info.fullType());
        assertEq(11, info.a);
    }

    # callFunction() calls any callable; Python iterators are Qore iterators; the global variables of a Python program
    # are read and set; __all__ is honored when it is a list; a Qore module that cannot be loaded raises ImportError
    pythonApiTest() {
        PythonProgram p("
import functools
part = functools.partial(pow, 2)
notcallable = 5
class K:
    def __init__(self, v):
        self.v = v
    @staticmethod
    def st(x):
        return x + 1
    @classmethod
    def cm(cls, x):
        return cls.__name__ + str(x)
def gen(n):
    for i in range(n):
        yield i * 10
def failing_gen():
    yield 1
    raise ValueError('generator failed')
class HasNext:
    def __iter__(self):
        return self
    def __next__(self):
        raise StopIteration
    def next(self):
        return 'own next'
def has_next():
    return HasNext()
def limit():
    return limits['max']
", "api.py");

        # any callable: a functools.partial object, a class, a builtin
        assertEq(8, p.callFunction("part", 3));
        assertEq(4, p.callFunction("K", 4).v);
        assertEq(3, p.callFunction("len", (1, 2, 3)));
        assertThrows("NO-FUNCTION", "'notcallable' is not callable", \p.callFunction(), "notcallable");
        assertThrows("NO-FUNCTION", "cannot find function 'nosuch'", \p.callFunction(), "nosuch");
        # static methods and class methods
        assertEq(2, p.callMethod("K", "st", 1));
        assertEq("K5", p.callMethod("K", "cm", 5));
        assertThrows("NO-METHOD", "cannot find method 'K\\.nosuch\\(\\)'", \p.callMethod(), ("K", "nosuch"));

        # a generator is a Qore iterator
        list<auto> l = ();
        foreach auto v in (p.callFunction("gen", 3)) {
            l += v;
        }
        assertEq((0, 10, 20), l);
        object it = p.callFunction("gen", 1);
        assertFalse(it.valid());
        assertThrows("ITERATOR-ERROR", "not on a valid iterator position", \it.getValue());
        assertTrue(it.next());
        assertTrue(it.valid());
        assertEq(0, it.getValue());
        assertFalse(it.next());
        assertFalse(it.valid());
        # an exception raised by the generator is raised by next()
        object fit = p.callFunction("failing_gen");
        assertTrue(fit.next());
        assertThrows("builtins.ValueError", "generator failed", \fit.next());
        # a type with its own next() method is not mapped
        assertEq("own next", p.callFunction("has_next").next());

        # the global variables of the program
        p.setAttribute("limits", {"max": 20});
        assertEq(20, p.callFunction("limit"));
        assertEq({"max": 20}, p.getAttribute("limits"));
        assertEq(5, p.getAttribute(name: "notcallable"));
        assertThrows("NO-ATTRIBUTE", "no global variable 'nosuch'", \p.getAttribute(), "nosuch");

        TmpDir tmp("python-api-");
        # __all__ as a list
        {
            File f();
            f.open2(tmp.path + "/allmod_list.py", O_WRONLY | O_CREAT | O_TRUNC);
            f.write("__all__ = ['pub']\ndef pub():\n    return 1\ndef notpub():\n    return 2\n");
            f.close();
            Program pgm(PO_NEW_STYLE);
            pgm.loadModule("python");
            pgm.issueModuleCmd("python", "add-module-path " + tmp.path);
            pgm.issueModuleCmd("python", "import allmod_list");
            pgm.parse("int sub pub() { return allmod_list::pub(); }\n", "allmod");
            assertEq(1, pgm.callFunction("pub"));
            assertThrows("NO-FUNCTION", \pgm.callFunction(), "allmod_list::notpub");
        }
        # importing a symbol runs Python code (here the __getattr__() of the module) that changes __all__; the names of
        # __all__ when the import started are imported; previously the items were read past the end of the changed
        # list (issue 5523)
        {
            File f();
            f.open2(tmp.path + "/allmod_shrink.py", O_WRONLY | O_CREAT | O_TRUNC);
            f.write("__all__ = ['a', 'b', 'c']
def __getattr__(name):
    if name in ('a', 'b', 'c'):
        __all__.clear()
        return lambda: name
    raise AttributeError(name)
");
            f.close();
            Program pgm(PO_NEW_STYLE);
            pgm.loadModule("python");
            pgm.issueModuleCmd("python", "add-module-path " + tmp.path);
            pgm.issueModuleCmd("python", "import allmod_shrink");
            pgm.parse("list<auto> sub names() { return (allmod_shrink::a(), allmod_shrink::b(), "
                "allmod_shrink::c()); }\n", "allmod-shrink");
            assertEq(("a", "b", "c"), pgm.callFunction("names"));
        }
        # names that cannot be encoded in UTF-8 (lone surrogates): in __all__ they raise UnicodeEncodeError; names of
        # dir() are not imported
        {
            File f();
            f.open2(tmp.path + "/allmod_surrogate.py", O_WRONLY | O_CREAT | O_TRUNC);
            f.write("__all__ = ['pub', '\\udc80']\ndef pub():\n    return 1\n");
            f.close();
            f.open2(tmp.path + "/dirmod_surrogate.py", O_WRONLY | O_CREAT | O_TRUNC);
            f.write("globals()['\\udc80'] = 1\ndef pub():\n    return 2\n");
            f.close();
            Program pgm(PO_NEW_STYLE);
            pgm.loadModule("python");
            pgm.issueModuleCmd("python", "add-module-path " + tmp.path);
            assertThrows("builtins.UnicodeEncodeError", "surrogates not allowed", \pgm.issueModuleCmd(),
                ("python", "import allmod_surrogate"));
            pgm.issueModuleCmd("python", "import dirmod_surrogate");
            pgm.parse("int sub pub() { return dirmod_surrogate::pub(); }\n", "dirmod");
            assertEq(2, pgm.callFunction("pub"));
        }
        # a module name that cannot be encoded in UTF-8 given to the meta path finder of the module
        {
            PythonProgram ip("import importlib\ndef imp(name):\n    try:\n        importlib.import_module(name)\n"
                "    except Exception as e:\n        return type(e).__name__\n", "imp_surrogate.py");
            assertEq("UnicodeEncodeError", ip.evalExpression("imp('\\udc80')"));
        }

        # a Qore module that cannot be loaded raises ImportError with the Qore exception as the cause; a module that
        # does not exist raises ModuleNotFoundError
        {
            File f();
            f.open2(tmp.path + "/PyApiBroken.qm", O_WRONLY | O_CREAT | O_TRUNC);
            f.write("%modern\nmodule PyApiBroken { version = \"1.0\"; desc = \"test\"; author = \"test\"; "
                "url = \"test\"; license = \"MIT\"; }\nthis is not valid\n");
            f.close();
            Program pgm(PO_NEW_STYLE);
            pgm.parse(sprintf("%%append-module-path %s\nint sub marker() { return 1; }\n", tmp.path), "broken");
            pgm.loadModule("python");
            pgm.issueModuleCmd("python", "parse broken_import import qoreloader\n"
                "def try_import(name):\n"
                "    try:\n"
                "        __import__('qore.' + name)\n"
                "    except ImportError as e:\n"
                "        return [type(e).__name__, str(e), type(e.__cause__).__name__ if e.__cause__ else None]\n");
            pgm.issueModuleCmd("python", "export-func try_import");
            list<auto> r = pgm.callFunction("try_import", "PyApiBroken");
            assertEq("ImportError", r[0]);
            assertRegex("^cannot load Qore module 'PyApiBroken': PARSE-EXCEPTION", r[1]);
            assertEq("QoreException", r[2]);
            r = pgm.callFunction("try_import", "PyApiNoSuchModule");
            assertEq(("ModuleNotFoundError", "No module named 'qore.PyApiNoSuchModule'", NOTHING), r);
        }
    }

    # Python values that a Qore value cannot represent raise an exception instead of crashing the process: containers
    # that contain themselves (the conversion recursed until the stack overflowed), strings with lone surrogates (the
    # failed UTF-8 conversion was not checked), and ints with more significant bits than a Qore number can hold (ints
    # were converted through repr(), which fails above sys.get_int_max_str_digits()); containers referenced more than
    # once without a cycle are converted each time (a dict was dropped or tripped an assertion), and ints at the int64
    # boundaries convert to the right type
    unrepresentableValueTest() {
        PythonProgram p("
import sys

def list_cycle():
    l = [1]
    l.append(l)
    return l

def tuple_cycle():
    t = ([],)
    t[0].append(t)
    return t

def dict_cycle():
    d = {}
    d['x'] = [d]
    return d

def shared():
    s = {'a': 1}
    l = [1, 2]
    return {'x': s, 'y': s, 'l': [l, l], 'd': [s, s]}

def surrogate():
    return '\\ud800'

def surrogate_key():
    return {'\\ud800': 1}

def bounds():
    return [-2**63, 2**63 - 1, 2**63, -2**63 - 1, -10**18, 10**18]

def big(n):
    return -(10**n + 123)

def big_low_limit(n):
    # the lowest limit allowed for converting ints to decimal strings
    old = sys.get_int_max_str_digits()
    sys.set_int_max_str_digits(640)
    try:
        return big(n)
    finally:
        sys.set_int_max_str_digits(old)

def pow2(n):
    return 2**n

def cyclic_args(cb, star):
    t = ([],)
    t[0].append(t)
    # with *t, CPython passes the tuple itself as the arguments of the call
    return cb(*t) if star else cb(t)

def cyclic_qore_args(star):
    from qore.__root__.Qore import type as qtype
    return cyclic_args(qtype, star)

def nested_args(cb):
    t = (1, [2, (3,)])
    return [cb(*t), cb(t)]
", "unrepresentable.py");

        map assertThrows("PYTHON-VALUE-ERROR", "contains itself", \p.callFunction(), $1), ("list_cycle", "tuple_cycle",
            "dict_cycle");
        # the arguments of calls from Python to Qore callables and functions
        code cb = auto sub (auto a) { return a; };
        foreach bool star in ((False, True)) {
            assertThrows("PYTHON-VALUE-ERROR", "contains itself", \p.callFunction(), ("cyclic_args", cb, star));
            assertThrows("PYTHON-VALUE-ERROR", "contains itself", \p.callFunction(), ("cyclic_qore_args", star));
        }
        assertEq(((1, (2, (3,))), ((1, (2, (3,))), NOTHING)), p.callFunction("nested_args",
            list<auto> sub (auto a, auto b) { return (a, b); }));
        assertEq({"x": {"a": 1}, "y": {"a": 1}, "l": ((1, 2), (1, 2)), "d": ({"a": 1}, {"a": 1})},
            p.callFunction("shared"));
        map assertThrows("builtins.UnicodeEncodeError", "surrogates not allowed", \p.callFunction(), $1),
            ("surrogate", "surrogate_key");

        list<auto> bounds = p.callFunction("bounds");
        assertEq((NT_INT, NT_INT, NT_NUMBER, NT_NUMBER, NT_INT, NT_INT), (map $1.typeCode(), bounds));
        assertEq(MININT, bounds[0]);
        assertEq(MAXINT, bounds[1]);
        assertEq(9223372036854775808n, bounds[2]);
        assertEq(-9223372036854775809n, bounds[3]);
        assertEq(-1000000000000000000, bounds[4]);

        # ints outside the int64 range are converted exactly, also with more digits than the limit for converting ints
        # to decimal strings
        foreach int digits in ((30, 2000)) {
            foreach string f in (("big", "big_low_limit")) {
                number n = p.callFunction(f, digits);
                assertEq(number("-1" + strmul("0", digits - 3) + "123"), n, sprintf("%s(%d)", f, digits));
                assertEq(-123n, n + number("1" + strmul("0", digits)), sprintf("%s(%d) exact", f, digits));
            }
        }
        # an int whose significant bits a Qore number can hold, although its bit length is bigger
        assertEq(p.callFunction("pow2", 8999) * 2, p.callFunction("pow2", 9000));
        # more significant bits than a Qore number can hold
        assertThrows("PYTHON-VALUE-ERROR", "significant bits", \p.callFunction(), ("big", 5000));
    }

    # a Qore number is a Python int when it is an exact integral value outside the int64 range (a Qore number holds
    # the Python ints outside the int64 range) and a decimal.Decimal otherwise, and a decimal.Decimal is a Qore number,
    # so that both round-trip with their types; previously every Qore number was None in
    # Python, so Python ints outside the int64 range did not survive a round trip.  A Qore value that cannot be
    # converted raises PYTHON-VALUE-ERROR instead of becoming None.
    numberConversionTest() {
        PythonProgram p("
import decimal

def typ(x):
    return type(x).__name__ + ': ' + repr(x)

def decimals():
    D = decimal.Decimal
    return [D('1.5'), D('-0.000123'), D('1.5E+3'), D('Infinity'), D('-Infinity'), D('NaN'), D('sNaN')]

class MyDecimal(decimal.Decimal):
    pass

def my_decimal():
    return MyDecimal('2.25')

def big():
    return [2**70, -2**70 - 1]

def is_big(l):
    return l == [2**70, -2**70 - 1] and all(type(v) is int for v in l)

def echo(x):
    return x
", "number.py");

        assertEq("Decimal: Decimal('1.5')", p.callFunction("typ", 1.5n));
        assertEq("Decimal: Decimal('0.1')", p.callFunction("typ", 0.1n));
        assertEq("Decimal: Decimal('100')", p.callFunction("typ", 100n));
        # the number has the precision to hold the integral value exactly
        assertEq("int: -125" + strmul("0", 98), p.callFunction("typ", -1.25e100n));
        # a number made from a float holds an approximation: its digits are not the exact value
        assertEq("Decimal: Decimal('1.0000000000000001E+300')", p.callFunction("typ", number(1e300)));
        assertEq("Decimal: Decimal('NaN')", p.callFunction("typ", @nan@n));
        assertEq("Decimal: Decimal('Infinity')", p.callFunction("typ", @inf@n));
        assertEq("Decimal: Decimal('-Infinity')", p.callFunction("typ", -@inf@n));

        list<auto> d = p.callFunction("decimals");
        assertEq((NT_NUMBER, NT_NUMBER, NT_NUMBER, NT_NUMBER, NT_NUMBER, NT_NUMBER, NT_NUMBER), (map $1.typeCode(), d));
        assertEq((1.5n, -0.000123n, 1500n, @inf@n, -@inf@n), d[0..4]);
        assertTrue(d[5].nanp(), "Decimal('NaN')");
        assertTrue(d[6].nanp(), "Decimal('sNaN')");
        assertEq(2.25n, p.callFunction("my_decimal"));

        # round trips
        assertTrue(p.callFunction("is_big", p.callFunction("big")), "Python ints outside the int64 range");
        assertEq((1.5n, -0.000123n, 1500n), p.callFunction("echo", d[0..2]), "Decimal round trip");
        foreach number n in ((1.5n, 0.1n, -1.25e100n, 123456789012345678901234567890n)) {
            assertEq(n, p.callFunction("echo", n), sprintf("Qore number %y round trip", n));
        }

        # a Qore value that has no Python representation
        int i = 1;
        assertThrows("PYTHON-VALUE-ERROR", "reference", \p.callFunction(), ("typ", \i));
    }

    # absolute dates keep their instant in both directions: a Qore date in the current time zone is a naive datetime,
    # a date in another zone an aware datetime with the date's UTC offset, and the UTC offset of an aware datetime is
    # read in full (west of UTC, a timedelta has days=-1, which were ignored, so -05:00 was +19:00; UTC was read as the
    # current time zone; dates in other zones were naive datetimes of their wall-clock time); relative dates of any
    # size and sign round-trip equal (they overflowed int, and -PT1S came back as -1 day + 86399 seconds); a time of
    # day is a Qore date on 1970-01-01 (it was a date in year 0, which could not be converted back)
    dateConversionTest() {
        # the current time zone, in which naive datetimes are read and Qore dates are naive, is set for the thread, so
        # that the test does not depend on the local time zone (ex: UTC); local dates are created at runtime in it
        set_thread_tz(new TimeZone(3600));
        on_exit set_thread_tz();
        date local_noon = date("2020-01-01T12:00:00");

        PythonProgram p("
from datetime import datetime, timedelta, time, timezone

def echo(x):
    return x

def offset_secs(d):
    return None if d.tzinfo is None else int(d.utcoffset().total_seconds())

def same(a, b):
    return a == b and type(a) is type(b) and (a.tzinfo is None) == (b.tzinfo is None) \\
        and (a.tzinfo is None or a.utcoffset() == b.utcoffset())

def py_dates():
    return [
        datetime(2020, 1, 1, 12, 0, 0, 123456),
        datetime(2020, 1, 1, 12, tzinfo=timezone.utc),
        datetime(2020, 1, 1, 12, tzinfo=timezone(timedelta(hours=-5))),
        datetime(2020, 1, 1, 12, tzinfo=timezone(timedelta(hours=-5, minutes=-30))),
        datetime(2020, 1, 1, 12, tzinfo=timezone(timedelta(hours=9))),
    ]

def py_deltas():
    return [timedelta.max, timedelta.min, timedelta(microseconds=-1), timedelta(seconds=-1.5),
        timedelta(hours=1000000)]

def total_secs(d):
    return d.total_seconds()

def times():
    return [time(10, 20, 30, 123456), time(10, 20, tzinfo=timezone(timedelta(hours=-5)))]

def us_offset():
    return datetime(2020, 1, 1, tzinfo=timezone(timedelta(microseconds=1)))
", "dates.py");

        # Python -> Qore: the instant and the UTC offset
        list<date> pd = p.callFunction("py_dates");
        assertEq(get_epoch_seconds(2020-01-01T12:00:00+01:00), get_epoch_seconds(pd[0]), "naive: current time zone");
        assertEq(3600, pd[0].info().utc_secs_east);
        assertEq(123456, pd[0].microseconds());
        list<int> offsets = (0, -18000, -19800, 32400);
        foreach int off in (offsets) {
            date d = pd[$# + 1];
            assertEq(off, d.info().utc_secs_east, sprintf("UTC offset %d", off));
            assertEq(get_epoch_seconds(2020-01-01T12:00:00Z) - off, get_epoch_seconds(d), sprintf("instant %d", off));
        }
        # Python round trips keep the value, the type and whether the datetime is naive
        foreach date d in (pd) {
            assertTrue(p.callFunction("same", p.callFunction("py_dates")[$#], p.callFunction("echo", d)),
                sprintf("Python round trip %d", $#));
        }

        # Qore -> Python: dates in other zones are aware datetimes with their offset, local dates are naive
        date tokyo = 2020-01-01T12:00:00+09:00;
        assertEq(32400, p.callFunction("offset_secs", tokyo));
        assertEq(0, p.callFunction("offset_secs", 2020-01-01T12:00:00Z));
        assertNothing(p.callFunction("offset_secs", local_noon));
        foreach date d in ((tokyo, 2020-01-01T12:00:00Z, 2020-01-01T12:00:00-05:30, local_noon + PT0.5S)) {
            date r = p.callFunction("echo", d);
            assertEq(get_epoch_seconds(d), get_epoch_seconds(r), sprintf("Qore round trip instant %y", d));
            assertEq(d.info().utc_secs_east, r.info().utc_secs_east, sprintf("Qore round trip offset %y", d));
            assertEq(d.microseconds(), r.microseconds(), sprintf("Qore round trip us %y", d));
        }

        # relative dates
        assertEq(3600000000.0, p.callFunction("total_secs", PT1000000H));
        foreach date d in ((PT1000000H, PT1H, -PT1S, -PT1.5S, -P1D, PT0S, P3DT4H5M6.7S)) {
            assertEq(d, p.callFunction("echo", d), sprintf("relative round trip %y", d));
        }
        list<date> pdelta = p.callFunction("py_deltas");
        assertEq(pdelta, p.callFunction("echo", pdelta), "timedelta round trip");
        assertEq(-PT0.000001S, pdelta[2]);
        assertEq(-PT1.5S, pdelta[3]);
        assertEq(PT1000000H, pdelta[4]);

        # times of day
        list<date> t = p.callFunction("times");
        assertEq((1970, 1, 1, 10, 20, 30, 123456), (map t[0].info(){$1}, ("year", "month", "day", "hour", "minute",
            "second")) + t[0].microseconds());
        assertEq(3600, t[0].info().utc_secs_east);
        assertEq(-18000, t[1].info().utc_secs_east);
        assertEq(10, t[1].hours());
        # a time of day converts back (as a datetime on 1970-01-01)
        assertEq(t[0], p.callFunction("echo", t[0]));

        assertThrows("PYTHON-DATETIME-ERROR", "microseconds", \p.callFunction(), "us_offset");
    }

    # subclasses of the converted types are converted as their base types (they were wrapped objects): ex: IntEnum,
    # StrEnum, OrderedDict, defaultdict, Counter; a named tuple is a hash of its fields, a set or frozenset a list, and
    # a memoryview a binary; dict keys that are not strings are converted with repr(), and a key that gives the same
    # Qore key as another one raises an exception (one value replaced the other silently)
    subclassConversionTest() {
        PythonProgram p("
import array, collections, datetime, enum

class Color(enum.IntEnum):
    RED = 1

class Name(str, enum.Enum):
    ADA = 'Ada'

class MyInt(int):
    pass

class MyFloat(float):
    pass

class MyList(list):
    pass

class MyTuple(tuple):
    pass

class MyBytes(bytes):
    pass

class MyDateTime(datetime.datetime):
    pass

Point = collections.namedtuple('Point', ['x', 'y'])

def values():
    return {
        'int_enum': Color.RED,
        'str_enum': Name.ADA,
        'int': MyInt(5),
        'float': MyFloat(1.5),
        'ordered': collections.OrderedDict([('b', 2), ('a', 1)]),
        'default': collections.defaultdict(list, {'k': [1]}),
        'counter': collections.Counter('aab'),
        'list': MyList([1, 2]),
        'tuple': MyTuple((1, 2)),
        'named': Point(1, [2, 3]),
        'bytes': MyBytes(b'ab'),
        'memoryview': memoryview(b'cd'),
        'datetime': MyDateTime(2020, 1, 1, tzinfo=datetime.timezone.utc),
    }

def sets():
    return [{3, 1, 2}, frozenset(['a'])]

def objects():
    return [1j, array.array('b', [1, 2])]

def keys():
    return {1: 'a', None: 'b', (1, 2): 'c'}

def colliding_keys():
    return {1: 'int', '1': 'str'}
", "subclasses.py");

        hash<auto> v = p.callFunction("values");
        assertEq(1, v.int_enum);
        assertEq(NT_INT, v.int_enum.typeCode());
        assertEq("Ada", v.str_enum);
        assertEq(5, v.int);
        assertEq(1.5, v.float);
        assertEq({"b": 2, "a": 1}, v.ordered);
        assertEq(("b", "a"), keys v.ordered, "the order of an OrderedDict");
        assertEq({"k": (1,)}, v.default);
        assertEq({"a": 2, "b": 1}, v.counter);
        assertEq((1, 2), v.list);
        assertEq((1, 2), v.tuple);
        assertEq({"x": 1, "y": (2, 3)}, v.named);
        assertEq(<6162>, v.bytes);
        assertEq(<6364>, v.memoryview);
        assertEq(2020-01-01T00:00:00Z, v.datetime);

        list<auto> sets = p.callFunction("sets");
        assertEq((1, 2, 3), sort(sets[0]));
        assertEq(("a",), sets[1]);

        # types without a Qore equivalent stay objects (a buffer other than a memoryview, ex: an array, is not converted
        # to its bytes)
        list<auto> objs = p.callFunction("objects");
        assertEq((NT_OBJECT, NT_OBJECT), (map $1.typeCode(), objs));

        assertEq({"1": "a", "None": "b", "(1, 2)": "c"}, p.callFunction("keys"));
        assertThrows("PYTHON-VALUE-ERROR", "same Qore hash key", \p.callFunction(), "colliding_keys");
    }

    # Python methods with the names of special Qore methods are imported with a '_' prefix (a method named constructor
    # or destructor tripped an assertion and could not be called; only copy was renamed); the constants of Python's
    # builtins module are not imported into Python::builtins (its exit and quit objects shadowed Qore's exit(), and
    # reading such a constant aborted the process at exit), while its functions and classes are
    # the callback of a weak reference to the Python object of a Qore object runs while the object is deallocated:
    # converting the Qore object to Python again gives another Python object (the object being deallocated was given,
    # which was then freed); calling __init__() again raises RuntimeError (it created another Qore object)
    qoreProxyLifetimeTest() {
        Counter c(7);
        PythonProgram p("
import gc, weakref
from qore.__root__.Qore.Thread import Counter as QoreCounter
saved = []
def run(get):
    p = get()
    def cb(r):
        saved.append(get())
    r = weakref.ref(p, cb)
    del p
    gc.collect()
    return [x.getCount() for x in saved]
def reinit():
    o = QoreCounter(2)
    try:
        o.__init__(3)
    except RuntimeError as e:
        return [str(e), o.getCount()]
    return 'no error'
", "proxy_lifetime.py");
        assertEq((7,), p.callFunction("run", Counter sub () { return c; }));
        assertEq(("the 'qore.Thread.Counter' object has already been initialized", 2), p.callFunction("reinit"));
    }

    # in free-threaded builds, other Python threads can change a list, a dict or a bytearray while it is converted to
    # Qore; list items are referenced atomically, a copy of a dict is iterated and a bytearray is copied in a critical
    # section.  Previously the conversion of a list read items that
    # another thread had removed and crashed the process (issue 5523).  With the GIL the test checks the same results.
    concurrentContainerTest() {
        PythonProgram p("
import threading

shared_l = [[i] for i in range(1000)]
shared_d = {str(i): [i] for i in range(1000)}
shared_b = bytearray(b'x' * 1000)
stop = False

def mutate():
    i = 0
    while not stop:
        i += 1
        shared_l.append([i])
        shared_l.pop(0)
        if i % 7 == 0:
            shared_l.clear()
            shared_l.extend([[j] for j in range(1000)])
        shared_d[str(i % 2000)] = [i]
        shared_d.pop(str((i + 1000) % 2000), None)
        if i % 13 == 0:
            shared_d.clear()
            shared_d.update({str(j): [j] for j in range(1000)})
        shared_b.extend(b'x' * 1000)
        del shared_b[:1000]
        if i % 11 == 0:
            shared_b.clear()
            shared_b.extend(b'x' * 2000)

thread = threading.Thread(target=mutate)

def start():
    thread.start()

def end():
    global stop
    stop = True
    thread.join()

def get():
    return [shared_l, shared_d, shared_b]
", "concurrent.py");
        p.callFunction("start");
        on_exit p.callFunction("end");
        hash<string, int> bad = {"list": 0, "dict": 0, "bytearray": 0};
        int converted = 0;
        for (int i = 0; i < 1000; ++i) {
            list<auto> v = p.callFunction("get");
            foreach auto e in (v[0]) {
                if (e.typeCode() != NT_LIST || e.size() != 1 || e[0].typeCode() != NT_INT) {
                    ++bad.list;
                }
            }
            foreach hash<auto> e in (v[1].pairIterator()) {
                if (e.value.typeCode() != NT_LIST || e.value.size() != 1 || e.value[0].typeCode() != NT_INT) {
                    ++bad.dict;
                }
            }
            # the bytearray has at most 3000 bytes, all 'x'
            binary b = v[2];
            if (b.size() > 3000 || b.toString().regex("[^x]")) {
                ++bad.bytearray;
            }
            converted += v[0].size() + v[1].size() + b.size();
        }
        assertEq({"list": 0, "dict": 0, "bytearray": 0}, bad, "every converted element is a value of the container");
        assertGt(0, converted);
    }

    # containers nested too deeply for the stack raise an exception instead of overflowing it; values that change
    # while they are converted (by Python code that the conversion runs) are referenced; str subclasses are string keys
    conversionRobustnessTest() {
        PythonProgram p("
import datetime, enum

def nested(n):
    x = []
    for i in range(n):
        x = [x]
    return x

def nested_dict(n):
    x = {}
    for i in range(n):
        x = {'a': x}
    return x

def depth(v):
    n = 0
    while v:
        v = v[0] if isinstance(v, list) else v['a']
        n += 1
    return n

items = []

class ClearingZone(datetime.tzinfo):
    # clears the list that holds the datetime while the datetime is converted
    def utcoffset(self, dt):
        items.clear()
        return datetime.timedelta(hours=1)
    def dst(self, dt):
        return datetime.timedelta(0)

def clearing():
    items.append(datetime.datetime(2020, 1, 2, 3, 4, 5, tzinfo=ClearingZone()))
    items.append(1)
    return items

class IntZone(datetime.tzinfo):
    def utcoffset(self, dt):
        return 3600
    def dst(self, dt):
        return None

def int_offset():
    return datetime.datetime(2020, 1, 1, tzinfo=IntZone())

class MyTime(datetime.time):
    pass

def time_subclass():
    return MyTime(1, 2, 3)

class Color(enum.StrEnum):
    RED = 'red'

def str_enum_key():
    return {Color.RED: 1}
", "robust.py");

        # values nested too deeply raise STACK-LIMIT-EXCEEDED (Qore's limit of the thread's stack) or
        # PYTHON-VALUE-ERROR (Python's recursion limit), whichever is reached first, also on the primary thread once
        # the jni module has created the JVM (qoretechnologies/qore#5518)
        code check = sub (code c) {
            string err = "no error";
            try {
                c();
            } catch (hash<ExceptionInfo> ex) {
                err = ex.err;
            }
            assertTrue(err == "STACK-LIMIT-EXCEEDED" || err == "PYTHON-VALUE-ERROR", err);
        };
        # Python -> Qore
        check(sub () { p.callFunction("nested", 1000000); });
        check(sub () { p.callFunction("nested_dict", 1000000); });
        # Qore -> Python
        {
            auto deep = ();
            for (int i = 0; i < 1000000; ++i) {
                deep = (deep,);
            }
            check(sub () { p.callFunction("depth", deep); });
        }
        {
            hash<auto> deep_hash = {};
            for (int i = 0; i < 1000000; ++i) {
                deep_hash = {"a": deep_hash};
            }
            check(sub () { p.callFunction("depth", deep_hash); });
        }
        # a moderately nested value is converted
        list<auto> l = p.callFunction("nested", 50);
        int n = 0;
        while (l) {
            l = l[0];
            ++n;
        }
        assertEq(50, n);

        # the list is cleared while its first element is converted
        list<auto> cleared = p.callFunction("clearing");
        assertEq(1, cleared.size());
        assertEq(2020-01-02T03:04:05+01:00, cleared[0]);

        # datetime.utcoffset() checks the offset that tzinfo.utcoffset() returns
        assertThrows("builtins.TypeError", "utcoffset", \p.callFunction(), "int_offset");

        # subclasses of datetime.time
        date t = p.callFunction("time_subclass");
        assertEq(1, t.hours());
        assertEq(2, t.minutes());
        assertEq(3, t.seconds());

        # a str subclass key is a string key
        assertEq({"red": 1}, p.callFunction("str_enum_key"));
    }

    # evalStatement() runs in the __main__ module of the interpreter, evalStatementKeep() and evalExpression() in the
    # globals of the program; statements have no value, and run() runs the code of the program again
    evalScopeTest() {
        PythonProgram p("x = 1\ndef get(name):\n    return globals().get(name, 'missing')\n", "scope.py");
        assertEq(NOTHING, p.evalStatement("y = 2\n42"));
        assertEq(NOTHING, p.evalStatementKeep("z = 3\n43"));
        # declarations of evalStatement() are kept in __main__, not in the globals of the program
        assertEq("missing", p.callFunction("get", "y"));
        assertEq(NOTHING, p.evalStatement("assert y == 2"));
        # evalStatement() does not see the globals of the program
        assertThrows("builtins.NameError", "'x' is not defined", \p.evalStatement(), "w = x");
        # declarations of evalStatementKeep() are globals of the program
        assertEq(3, p.callFunction("get", "z"));
        assertEq(3, p.evalExpression("z"));
        p.evalStatementKeep("def tax(amount):\n    return amount * rate\nrate = 0.2");
        assertEq(20.0, p.callFunction("tax", 100));

        # run() runs the code of the program again
        p.evalStatementKeep("x = 5");
        assertEq(5, p.evalExpression("x"));
        assertEq(NOTHING, p.run());
        assertEq(1, p.evalExpression("x"));
        # globals that the code does not set are kept
        assertEq(3, p.evalExpression("z"));
    }

    # the errors of the module commands give their syntax
