    heapTypeReferenceTest() {
        PythonProgram p("
import gc
import sys
from qore.__root__.Qore.Thread import Counter

class DerivedCounter(Counter):
    pass

def delta(cls):
    gc.collect()
    before = sys.getrefcount(cls)
    for _ in range(20):
        # Exercise allocation/deallocation without creating a Qore object whose
        # explicit cross-language lifetime would retain the Python instance.
        obj = cls.__new__(cls)
        assert isinstance(obj, cls)
        assert gc.is_tracked(obj)
        del obj
    gc.collect()
    return sys.getrefcount(cls) - before

def test():
    return delta(Counter), delta(DerivedCounter)
", "heap-type-references.py");
        assertEq((0, 0), p.callFunction("test"));
    }

    interpreterFinalizationTest() {
        TmpFile output("qore-python-finalize-", ".txt");
        for (int iteration = 0; iteration < 3; ++iteration) {
            PythonProgram p("
import atexit
import gc
import weakref

class Cycle:
    pass

def configure(path):
    def record(value):
        with open(path, 'a', encoding='utf-8') as stream:
            stream.write(value + '\\n')
    # A cyclic object tests weakref finalization as well as explicit atexit hooks.
    item = Cycle()
    item.self = item
    weakref.finalize(item, record, 'weakref')
    gc.collect()
    atexit.register(record, 'atexit')

def echo(value):
    return value
", "finalization.py");
            p.callFunction("configure", output.path);
            if (!Python::FreeThreading) {
                ThreadPool pool();
                on_exit pool.stopWait();
                Queue values();
                for (int value = 0; value < 4; ++value) {
                    # Capture a separate value for each submitted task.
                    int input = value;
                    pool.submit(sub() {
                        values.push(p.callFunction("echo", input));
                    });
                }
                pool.stopWait();
                list<int> received;
                for (int value = 0; value < 4; ++value) {
                    received += values.get();
                }
                assertEq((0, 1, 2, 3), sort(received));
            }
            delete p;
            assertEq("atexit\nweakref\n", output.file.read(-1));
        }
    }

    crossThreadFinalizationTest() {
        TmpFile output("qore-python-thread-finalize-", ".txt");
        string source = "
import atexit
import threading

def configure(path):
    def record():
        with open(path, 'a', encoding='utf-8') as stream:
            stream.write('finalized\\n')
    atexit.register(record)

def echo(value):
    return value
";
        Queue values();
        ThreadPool pool();
        on_exit pool.stopWait();
        pool.submit(sub() {
            PythonProgram created(source, "created-on-worker.py");
            created.callFunction("configure", output.path);
            values.push(created);
        });
        PythonProgram from_worker = values.get();
        pool.stopWait();
        assertEq(23, from_worker.callFunction("echo", 23));
        delete from_worker;
        assertEq("finalized\n", output.file.read(-1));

        PythonProgram from_main(source, "destroyed-on-worker.py");
        from_main.callFunction("configure", output.path);
        ThreadPool cleanup_pool();
        on_exit cleanup_pool.stopWait();
        cleanup_pool.submit(sub() {
            values.push(from_main.callFunction("echo", 42));
            delete from_main;
        });
        cleanup_pool.stopWait();
        assertEq(42, values.get());
        assertEq("finalized\n", output.file.read(-1));
    }

