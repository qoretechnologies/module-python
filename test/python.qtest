        PythonProgram p("
import qoreloader
import qore.__root__.Jni.java.time as jt

def get_attrs():
    i = jt.Instant
    return {
        'name': i.__name__,
        'epoch': hasattr(i, 'EPOCH'),
        'min': hasattr(i, 'MIN'),
        'max': hasattr(i, 'MAX'),
    }
", "java-date-constant-test");

