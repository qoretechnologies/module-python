#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.

%modern
%no-child-restrictions

# conversion to Python has to resolve these; see indirectReferencesTest()
%allow-weak-references
%allow-opaque-references

%prepend-module-path "${SCRIPT_DIR}/../qlib"
%requires python
%requires QUnit
%requires reflection
%requires FsUtil
%requires json
%requires WebSocketClient
# JNI is loaded dynamically at runtime in javaTest() to avoid conflicts with
# Python free-threading mode (PEP 703) - mimalloc is not compatible with JNI threads
%try-module xml
%define NO_XML
%endtry
# Process::getEnvironment() reads the whole environment; see environmentTest()
%try-module process
%define NO_PROCESS
%endtry

%exec-class PythonTest

#! reads a file; used to check the sandbox that governs Python threads
class PythonSandboxTestReader {
    static string readFile(string path) {
        return ReadOnlyFile::readTextFile(path);
    }
}

class PythonTest inherits Test {
    public {
        const ExprTests = (
            {"expr": "1 + 1", "val": 2},
            {"expr": "1.1", "val": 1.1},
            {"expr": "True", "val": True},
            {"expr": "False", "val": False},
            {"expr": "'str'", "val": "str"},
            {"expr": "bytes.fromhex('abcd')", "val": <abcd>},
            {"expr": "bytearray.fromhex('abcd')", "val": <abcd>},
            {"expr": "{'a': 1}", "val": {"a": 1}},
            {"expr": "(1).bit_length()", "val": 1},
        );

        const Values = (
            1,
            1.1,
            True,
            False,
            "str",
            <abcd>,
            {"a": 1},
            (1, 2, 3),
        );
    }

    constructor() : Test("python test", "1.0", \ARGV) {
        addTestCase("python thread test", \pythonThreadTest());
        addTestCase("super test", \superTest());
        addTestCase("java test", \javaTest());
        addTestCase("date range test", \dateRangeTest());
        addTestCase("java date constant test", \javaDateConstantTest());
        addTestCase("exception test", \exceptionTest());
        addTestCase("exception frame ownership", \exceptionFrameOwnershipTest());
        addTestCase("qore test", \qoreTest());
        addTestCase("stack test", \stackTest());
        addTestCase("thread test", \threadTest());
        addTestCase("python callbacks", \pythonCallbackTest());
        addTestCase("indirect references", \indirectReferencesTest());
        addTestCase("python import", \pythonImportTest());
        addTestCase("object lifecycle", \objectLifecycleTest());
        addTestCase("basic test", \basicTest());
        addTestCase("Python call protocol", \callProtocolTest());
        addTestCase("interpreter finalization", \interpreterFinalizationTest());
        addTestCase("interpreter finalization on another thread", \crossThreadFinalizationTest());
        addTestCase("wrapper heap type references", \heapTypeReferenceTest());
        addTestCase("object cleanup after another interpreter", \independentDestructorTest());
        addTestCase("wrapper interpreter isolation", \wrapperInterpreterIsolationTest());
        addTestCase("objects crossing interpreter boundaries", \crossInterpreterObjectTest());
        addTestCase("module spec failure recovery", \moduleSpecFailureTest());
        addTestCase("references surviving interpreter finalization", \persistentReferenceFinalizationTest());
        addTestCase("named argument calls", \namedArgumentTest());
        addTestCase("import test", \importTest());
        addTestCase("qoreloader shared namespace import", \qoreloaderSharedNamespaceImportTest());
        addTestCase("qoreloader multi-namespace import", \qoreloaderMultiNamespaceImportTest());
        addTestCase("type conversion test", \typeConversionTest());
        addTestCase("conversion of cyclic, shared and unrepresentable Python values", \unrepresentableValueTest());
        addTestCase("Qore number <-> Python int and decimal.Decimal", \numberConversionTest());
        addTestCase("date/time conversion: time zones, relative dates and times of day", \dateConversionTest());
        addTestCase("conversion of subclasses, named tuples, sets, memoryviews and dict keys",
            \subclassConversionTest());
        addTestCase("special Qore method names and the builtins namespace", \specialNameTest());
        addTestCase("sandbox interrupt test", \sandboxInterruptTest());
        addTestCase("Python threads call Qore", \pythonThreadEntryTest());
        addTestCase("a Qore callable runs without the GIL", \callableGilTest());
        addTestCase("Python threads run under the sandbox of the interpreter's Program", \sandboxPythonThreadTest());
        addTestCase("restricted Programs cannot run Python code", \restrictedProgramTest());
        addTestCase("os.environ changes are serialized with Qore", \environmentTest());
        addTestCase("an interpreter copies the environment under Qore's lock", \interpreterEnvironmentCopyTest());
        addTestCase("fork() while another thread holds a lock of the module", \forkHandlersTest());
        # Set return value for compatibility with test harnesses that check the return value
        set_return_value(main());
    }

    # Qore code called from a thread that Python created: such a thread has no Qore thread data until it is
    # registered with Qore.  Previously only Qore method calls registered it; a call of a Qore callable or function, a
    # constructor, a member read, a class import and the release of a Qore callable on such a thread used the Qore API
    # without thread data and crashed the process.
    pythonThreadEntryTest() {
        if (Python::FreeThreading) {
            testSkip("Python threads in sub-interpreters not supported with free-threading (PEP 703)");
        }
        Program pgm(PO_NO_CHILD_PO_RESTRICTIONS);
        pgm.parse("%modern
%requires python
namespace EntryTest {
    string sub qore_func(string s) {
        return \"function \" + s;
    }

    class Holder {
        public {
            string value = \"member\";
        }
    }

    class Tracker {
        public {
            Queue queue;
        }

        constructor(Queue queue) {
            self.queue = queue;
        }

        destructor() {
            queue.push(\"destroyed\");
        }
    }
}

EntryTest::Holder sub make_holder() {
    return new EntryTest::Holder();
}

# returns a closure that is the only owner of an object whose destructor reports to the queue
code sub make_tracked_callable(Queue queue) {
    EntryTest::Tracker tracker(queue);
    return auto sub () { return tracker; };
}
", "entry-test");
        pgm.issueModuleCmd("python", "import-ns EntryTest et");
        pgm.issueModuleCmd("python", "parse entry_test.py from threading import Thread

def in_thread(fn):
    out = []
    def target():
        try:
            out.append(fn())
        except Exception as e:
            out.append('error: ' + repr(e))
    th = Thread(target = target)
    th.start()
    th.join()
    return out[0]

def py_call_callable(c, arg):
    return in_thread(lambda: c(arg))

def py_call_function(arg):
    return in_thread(lambda: et.qore_func(arg))

def py_construct():
    return in_thread(lambda: et.Holder().value)

def py_read_member(h):
    return in_thread(lambda: h.value)

def py_import_class():
    def imp():
        import qoreloader
        from qore.__root__.Qore.Thread import Sequence
        return Sequence(5).next()
    return in_thread(imp)

kept = []

def py_keep(c):
    kept.append(c)

def py_drop():
    return in_thread(lambda: kept.clear())

def py_construct_and_use():
    def f():
        h = et.Holder()
        return h.value
    return in_thread(f)

def py_lock_across_calls(m):
    def f():
        m.lock()
        m.unlock()
        return 'unlocked'
    return in_thread(f)

def py_thread_tid():
    import qoreloader
    from qore import gettid
    return in_thread(lambda: gettid())
");
        map pgm.issueModuleCmd("python", "export-func " + $1), ("py_call_callable", "py_call_function", "py_construct",
            "py_read_member", "py_import_class", "py_keep", "py_drop", "py_construct_and_use",
            "py_lock_across_calls", "py_thread_tid");

        assertEq("callable x", pgm.callFunction("py_call_callable", string sub (string s) { return "callable " + s; },
            "x"), "a Qore callable called in a Python thread");
        assertEq("function y", pgm.callFunction("py_call_function", "y"), "a Qore function called in a Python thread");
        assertEq("member", pgm.callFunction("py_construct"), "a Qore object constructed in a Python thread");
        assertEq("member", pgm.callFunction("py_read_member", pgm.callFunction("make_holder")),
            "a member read in a Python thread");
        assertEq(5, pgm.callFunction("py_import_class"), "a Qore class imported in a Python thread");

        # the last reference to a Qore callable is released in a Python thread, which runs the destructor of the
        # object it owns there
        Queue destroyed();
        pgm.callFunction("py_keep", pgm.callFunction("make_tracked_callable", destroyed));
        assertEq(0, destroyed.size(), "the callable is kept by Python");
        pgm.callFunction("py_drop");
        assertEq("destroyed", destroyed.get(), "the callable was released in a Python thread");

        # a Python thread is a Qore thread while it runs: a Qore object that it creates is kept, and a lock that it
        # acquires stays its own, from one call to the next
        assertEq("member", pgm.callFunction("py_construct_and_use"), "an object created in a Python thread is kept");
        assertEq("unlocked", pgm.callFunction("py_lock_across_calls", new Mutex()),
            "a lock acquired in a Python thread stays its own");

        # a Python thread is no longer registered with Qore once it has ended
        int tid = pgm.callFunction("py_thread_tid");
        assertTrue(tid > 0, "the Python thread had a Qore thread ID");
        assertFalse(inlist(tid, thread_list()), "the ended Python thread is deregistered");
    }

    # a Qore callable called from Python runs without the GIL, as Qore methods and functions do, so that it can wait
    # for another Python thread.  Previously it ran with the GIL held, and a callable waiting for a Python thread
    # waited forever (the test runner's time limit is only a guard).
    callableGilTest() {
        if (Python::FreeThreading) {
            testSkip("Python threads in sub-interpreters not supported with free-threading (PEP 703)");
        }
        PythonProgram p("
from threading import Thread

def call_waiting(c, running, done):
    # the thread waits until the callable runs, then returns to Python code, which needs the GIL
    def target():
        running.get()
        done.push('pushed by a Python thread')
    thread = Thread(target = target)
    thread.start()
    rv = c()
    thread.join()
    return rv
", "callable-gil.py");
        Queue running();
        Queue done();
        code c = auto sub () {
            running.push(True);
            return done.get();
        };
        assertEq("pushed by a Python thread", p.callFunction("call_waiting", c, running, done));
    }

    # Python code is not subject to Qore's restrictions (it can use the filesystem, start processes and use the
    # network), so every way to reach Python is an uncontrolled API: a Program restricted with PO_NO_UNCONTROLLED_APIS
    # (included in PO_NO_EXTERNAL_ACCESS, PO_NO_IO and PO_LOCKDOWN) can neither create Python interpreters nor issue
    # python module commands, and a Program restricted with PO_NO_EMBEDDED_LOGIC can neither create interpreters nor
    # parse Python code with a module command.  Previously the PythonProgram class was only in the EMBEDDED_LOGIC
    # domain and the module commands did not check the parse options, so restricted Programs could run any Python code.
    restrictedProgramTest() {
        TmpDir tmp("python-restricted-");
        string marker = tmp.path + DirSep + "marker";
        # Python code that shows that it ran by creating the marker file
        string py_code = sprintf("open(%y, 'w').close()", marker);

        # the restrictions that block both the PythonProgram class and all module commands
        hash<string, int> uncontrolled = {
            "PO_NO_UNCONTROLLED_APIS": PO_NO_UNCONTROLLED_APIS,
            "PO_NO_EXTERNAL_ACCESS": PO_NO_EXTERNAL_ACCESS,
            "PO_LOCKDOWN": PO_LOCKDOWN,
        };
        # the PythonProgram class, its static methods and creating it at runtime, with the expected errors
        hash<string, list<string>> class_code = {
            "constructor": (sprintf("PythonProgram pp(%y, 'restricted.py');", py_code), "ILLEGAL-CLASS-INSTANTIATION"),
            "static method": (sprintf("PythonProgram::evalStatement(%y);", py_code), "INVALID-METHOD"),
            "create_object()": (sprintf("create_object('PythonProgram', %y, 'restricted.py');", py_code),
                "CREATE-OBJECT-ERROR"),
        };
        foreach hash<auto> r in ((uncontrolled + {"PO_NO_EMBEDDED_LOGIC": PO_NO_EMBEDDED_LOGIC}).pairIterator()) {
            foreach hash<auto> c in (class_code.pairIterator()) {
                Program pgm(r.value | PO_NEW_STYLE);
                code parse_run = sub () {
                    pgm.parse(c.value[0], "restricted");
                    pgm.run();
                };
                assertThrows(c.value[1], "PythonProgram", parse_run, NOTHING, sprintf("%s: %s", r.key, c.key));
                assertFalse(is_file(marker), sprintf("%s: %s: the Python code did not run", r.key, c.key));
            }
        }

        # every module command, issued at parse time and at runtime
        list<string> cmds = (
            "parse restricted.py " + py_code,
            "import os",
            "import-ns Qore qore_ns",
            "alias os.path ospath",
            "export-class object",
            "export-func print",
            "add-module-path " + tmp.path,
        );
        foreach hash<auto> r in (uncontrolled.pairIterator()) {
            foreach string cmd in (cmds) {
                {
                    Program pgm(r.value | PO_NEW_STYLE);
                    assertThrows("PYTHON-PARSE-COMMAND-ERROR", "PO_NO_UNCONTROLLED_APIS", \pgm.parse(),
                        ("%module-cmd(python) " + cmd + "\n", "restricted"), sprintf("%s: parse: %s", r.key, cmd));
                }
                {
                    Program pgm(r.value | PO_NEW_STYLE);
                    assertThrows("PYTHON-PARSE-COMMAND-ERROR", "PO_NO_UNCONTROLLED_APIS", \pgm.issueModuleCmd(),
                        ("python", cmd), sprintf("%s: issueModuleCmd(): %s", r.key, cmd));
                }
                assertFalse(is_file(marker), sprintf("%s: %s: the Python code did not run", r.key, cmd));
            }
        }

        # PO_NO_EMBEDDED_LOGIC blocks parsing Python code; the other commands do not parse code
        {
            Program pgm(PO_NO_EMBEDDED_LOGIC | PO_NEW_STYLE);
            assertThrows("PYTHON-PARSE-COMMAND-ERROR", "PO_NO_EMBEDDED_LOGIC", \pgm.issueModuleCmd(),
                ("python", "parse restricted.py " + py_code));
            assertFalse(is_file(marker), "PO_NO_EMBEDDED_LOGIC: parse: the Python code did not run");
            pgm.issueModuleCmd("python", "import os");
            pgm.parse("string sub sep() { return os::sep; }", "restricted");
            assertEq(DirSep, pgm.callFunction("sep"), "PO_NO_EMBEDDED_LOGIC: import is allowed");
        }

        # Python code is not subject to the other restrictions (ex: PO_NO_FILESYSTEM): the same command runs it
        {
            Program pgm(PO_NO_FILESYSTEM | PO_NEW_STYLE);
            pgm.issueModuleCmd("python", "parse restricted.py " + py_code);
            assertTrue(is_file(marker), "an unrestricted module command runs the Python code");
        }
    }

    # the code of the interpreter of a sandboxed Program is governed by its sandbox also on the threads that Python
    # creates, where no Qore code calls it: a closure of an unrestricted Program called there is governed by it as when
    # it is called on a Qore thread.  Previously such a thread ran with no sandbox, and the closure read a file that the
    # sandbox forbade.  The sandbox is attached after the interpreter of the Program was created (the Program inherits
    # the python module of this Program when it is constructed), so it is resolved when the call is made.
    sandboxPythonThreadTest() {
        if (Python::FreeThreading) {
            testSkip("Python threads in sub-interpreters not supported with free-threading (PEP 703)");
        }
        TmpDir tmp("python-sandbox-thread-");
        string dir = tmp.path;
        string secret = dir + DirSep + "secret.txt";
        {
            File f();
            f.open2(secret, O_CREAT | O_WRONLY | O_TRUNC, 0600);
            f.write("secret");
        }

        SandboxManager sm();
        sm.setFilesystemDefaultPolicy(True);
        sm.addFilesystemDeniedPath(dir);
        Program pgm(PO_NO_CHILD_PO_RESTRICTIONS);
        pgm.setSandboxManager(sm);
        # a class of this unrestricted Program, which is governed by the sandbox of the code that calls it
        pgm.importClass("PythonSandboxTestReader", "SandboxTest::Reader");
        pgm.parse("%modern
%requires python
", "python-sandbox-thread");
        pgm.issueModuleCmd("python", "import-ns SandboxTest st");
        pgm.issueModuleCmd("python", "parse sandbox_thread.py from threading import Thread

def read(path):
    try:
        return st.Reader.readFile(path)
    except Exception as e:
        return 'error: ' + repr(e)

def py_read_here(path):
    return read(path)

def py_read_in_thread(path):
    out = []
    thread = Thread(target = lambda: out.append(read(path)))
    thread.start()
    thread.join()
    return out[0]

def call(reader, path):
    try:
        return reader(path)
    except Exception as e:
        return 'error: ' + repr(e)

def py_call_here(reader, path):
    return call(reader, path)

def py_call_in_thread(reader, path):
    out = []
    thread = Thread(target = lambda: out.append(call(reader, path)))
    thread.start()
    thread.join()
    return out[0]
");
        map pgm.issueModuleCmd("python", "export-func " + $1), ("py_read_here", "py_read_in_thread", "py_call_here",
            "py_call_in_thread");

        # the file can be read outside the sandbox
        assertEq("secret", PythonSandboxTestReader::readFile(secret));
        # on the calling Qore thread, the sandboxed code that calls the function governs it
        *string here = pgm.callFunction("py_read_here", secret);
        assertRegex("FILESYSTEM-ACCESS-DENIED", here, "the read on the Qore thread is denied");
        # on a thread that Python created in the sandboxed program's interpreter
        *string in_thread = pgm.callFunction("py_read_in_thread", secret);
        assertRegex("FILESYSTEM-ACCESS-DENIED", in_thread, "the read on the Python thread is denied");

        # a closure of this unrestricted Program given to the sandboxed code, which runs in this Program
        code reader = string sub (string path) { return ReadOnlyFile::readTextFile(path); };
        assertRegex("FILESYSTEM-ACCESS-DENIED", pgm.callFunction("py_call_here", reader, secret),
            "the closure called on the Qore thread is denied");
        assertRegex("FILESYSTEM-ACCESS-DENIED", pgm.callFunction("py_call_in_thread", reader, secret),
            "the closure called on the Python thread is denied");
    }

    # os.putenv() and os.unsetenv(), which os.environ uses, change the environment under the lock that serializes the
    # environment with Qore: a Python thread changing variables while Qore reads the environment.  Previously Python
    # changed the environment without the lock, and a Qore thread reading it at the same time could read freed memory
    # (a crash, shown by repeated runs, not deterministically).
    environmentTest() {
        if (Python::FreeThreading) {
            testSkip("Python threads in sub-interpreters not supported with free-threading (PEP 703)");
        }
        PythonProgram p("
import os
from threading import Thread

def set_var(name, value):
    os.environ[name] = value

def del_var(name):
    del os.environ[name]

def check(fn, *args):
    try:
        fn(*args)
        return 'accepted'
    except OSError as e:
        return 'OSError %d' % e.errno
    except ValueError as e:
        return str(e)

def checks():
    return [check(os.putenv, '', 'x'), check(os.putenv, 'A=B', 'x'), check(os.putenv, 'A\\0B', 'x'),
        check(os.unsetenv, 'A=B')]

def change_in_thread(prefix, count, start, done):
    def target():
        try:
            start.get()
            for i in range(count):
                name = '%s%d' % (prefix, i % 50)
                os.environ[name] = 'v' * (64 + i % 64)
                if i % 3:
                    del os.environ[name]
        finally:
            done.dec()
    thread = Thread(target = target)
    thread.start()
    return thread

def join(thread):
    thread.join()
", "environment.py");

        string name = sprintf("QORE_PYTHON_ENV_%d", getpid());
        on_exit unsetenv(name);
        # a change made in Python is seen by Qore
        p.callFunction("set_var", name, "set in Python");
        assertEq("set in Python", getenv(name));
        p.callFunction("del_var", name);
        assertNothing(getenv(name));
        # the arguments are checked as Python checks them
        assertEq(("OSError " + EINVAL, "illegal environment variable name", "embedded null byte", "OSError " + EINVAL),
            p.callFunction("checks"));

        # Qore reads the environment while a Python thread changes it
        string prefix = sprintf("QORE_PYTHON_ENV_CHANGE_%d_", getpid());
        on_exit {
            for (int i = 0; i < 50; ++i) {
                unsetenv(prefix + i);
            }
        }
        # with a process module that has Process::getEnvironment(), the whole environment is also read, which keeps a
        # reader in the environment for longer (previously a crash in every run)
        *code read_all;
%ifndef NO_PROCESS
        try {
            call_static_method("Qore::Process::Process", "getEnvironment");
            read_all = sub () { call_static_method("Qore::Process::Process", "getEnvironment"); };
        } catch (hash<ExceptionInfo> ex) {
            # the process module has no Process::getEnvironment()
        }
%endif
        Queue start();
        Counter done(1);
        auto thread = p.callFunction("change_in_thread", prefix, 20000, start, done);
        int found = 0;
        # the Python thread starts changing the environment when the reads start
        start.push(True);
        while (done.getCount()) {
            if (exists getenv(prefix + "unset")) {
                ++found;
            }
            if (read_all) {
                read_all();
            }
        }
        p.callFunction("join", thread);
        assertEq(0, found, "a variable that was never set was not found");
    }

    # each interpreter copies the environment when its posix module is created (into posix.environ, which becomes
    # os.environ) and its time module reads TZ; both are done under Qore's environment lock, by the module's exec
    # functions of these modules, which hold the lock while they call Python's.  Previously the copy made while a
    # subinterpreter was created could read the environment while a Qore thread changed it.  A race cannot be
    # reproduced reliably, so the test checks that the exec functions are the module's (in its shared object, not in
    # the Python library), and that they still make the copies.
    interpreterEnvironmentCopyTest() {
        string name = sprintf("QORE_PYTHON_ENV_COPY_%d", getpid());
        on_exit unsetenv(name);
        setenv(name, "set before the interpreter");
        PythonProgram p("
import ctypes
import os
import posix
import time

class DlInfo(ctypes.Structure):
    _fields_ = [('dli_fname', ctypes.c_char_p), ('dli_fbase', ctypes.c_void_p), ('dli_sname', ctypes.c_char_p),
        ('dli_saddr', ctypes.c_void_p)]

class ModuleDefSlot(ctypes.Structure):
    _fields_ = [('slot', ctypes.c_int), ('value', ctypes.c_void_p)]

# the file that contains the code at the given address
def code_file(address):
    dl = ctypes.CDLL(None)
    dl.dladdr.argtypes = [ctypes.c_void_p, ctypes.POINTER(DlInfo)]
    info = DlInfo()
    if not dl.dladdr(address, ctypes.byref(info)):
        return None
    return os.path.realpath(info.dli_fname.decode())

# the exec function of a module with multi-phase initialization
def exec_function(module):
    api = ctypes.pythonapi
    api.PyModule_GetDef.restype = ctypes.c_void_p
    api.PyModule_GetDef.argtypes = [ctypes.py_object]
    module_def = api.PyModule_GetDef(module)
    # PyModuleDef: PyModuleDef_Base (PyObject, m_init, m_index, m_copy), m_name, m_doc, m_size, m_methods, m_slots
    offset = object.__basicsize__ + ctypes.sizeof(ctypes.c_void_p) * 7
    slots = ctypes.c_void_p.from_address(module_def + offset).value
    i = 0
    while True:
        slot = ModuleDefSlot.from_address(slots + i * ctypes.sizeof(ModuleDefSlot))
        if not slot.slot:
            return None
        if slot.slot == 2:
            return slot.value
        i += 1

def files():
    return {
        'python': code_file(ctypes.cast(ctypes.pythonapi.Py_IsInitialized, ctypes.c_void_p).value),
        'posix': code_file(exec_function(posix)),
        'time': code_file(exec_function(time)),
    }

def copied(name):
    return os.environ.get(name)
", "environment-copy.py");
        assertEq("set before the interpreter", p.callFunction("copied", name));
        hash<auto> files = p.callFunction("files");
        assertNeq(files.python, files.posix, "the exec function of posix is not Python's");
        assertNeq(files.python, files.time, "the exec function of time is not Python's");
        assertEq(files.posix, files.time, "both exec functions are the module's");
    }

    # a child process created with fork() while another thread holds a process-wide lock of the module can use Python:
    # the module registers fork handlers for its locks.  Without them, the child got the lock held by a thread that
    # does not exist in it and waited forever for it (the test runner's time limit is only a guard).
    forkHandlersTest() {
        if (!Option::HAVE_FORK) {
            testSkip("fork() is not available");
        }
        if (!Option::HAVE_LIBRARY_DEBUGGING) {
            testSkip("the test needs a debug build of the library");
        }
        foreach string name in ("python_thread_states", "python_program_validity", "python_program_registry") {
            # another thread holds the lock while fork() is called; the child creates an interpreter and calls it
            hash<auto> r = call_function("dbg_fork_while_handler_held", name, int sub () {
                PythonProgram child("def f(x):\n    return x + 1\n", "fork-child.py");
                return child.callFunction("f", 1) == 2 ? 0 : 1;
            });
            assertTrue(r.waited, name + ": fork() waited for the thread holding the lock");
            assertEq(0, r.status, name + ": the child used Python");
        }
    }

    moduleSpecFailureTest() {
        foreach string name in ("qore", "qore.__root__") {
            PythonProgram p("
import importlib
import importlib.machinery

original = importlib.machinery.ModuleSpec
def failing(*args, **kwargs):
    raise MemoryError('injected module spec failure')

def load(name, fail):
    importlib.machinery.ModuleSpec = failing if fail else original
    try:
        importlib.import_module(name)
        return True
    finally:
        importlib.machinery.ModuleSpec = original
", "module-spec-failure.py");
            # Load the parent first so the second iteration exercises the root spec.
            if (name == "qore.__root__") {
                p.callFunction("load", "qore", False);
            }
            assertThrows("builtins.MemoryError", sub() { p.callFunction("load", name, True); });
            assertTrue(p.callFunction("load", name, False));
        }
    }

    crossInterpreterObjectTest() {
        PythonProgram owner("
class Tracked:
    def value(self):
        return 73

original = Tracked()
def get():
    return original

def same(obj):
    return obj is original
", "cross-interpreter-owner.py");
        PythonProgram receiver("
import gc

saved = None
def accept(obj):
    global saved
    saved = obj
    gc.collect()
    return obj.value(), type(obj).__module__, gc.is_tracked(obj)

def value():
    return saved.value()

def get():
    return saved
", "cross-interpreter-receiver.py");
        auto obj = owner.callFunction("get");
        assertTrue(owner.callFunction("same", obj));
        assertEq((73, "qore", True), receiver.callFunction("accept", obj));
        assertEq(obj.uniqueHash(), receiver.callFunction("get").uniqueHash());
        assertTrue(owner.callFunction("same", receiver.callFunction("get")));
        delete owner;
        assertThrows("PYTHON-INTERPRETER-DELETED", sub() { receiver.callFunction("value"); });
        delete receiver;
        delete obj;
    }

    persistentReferenceFinalizationTest() {
        TmpFile output("qore-python-references-", ".txt");
        PythonProgram owner("
import weakref

class Tracked:
    def value(self):
        return 17

def record(path, label):
    with open(path, 'a', encoding='utf-8') as stream:
        stream.write(label + '\\n')

def make_object(path):
    obj = Tracked()
    weakref.finalize(obj, record, path, 'object').atexit = False
    return obj

def make_callable(path):
    obj = Tracked()
    weakref.finalize(obj, record, path, 'callable').atexit = False
    return lambda: obj.value()
", "persistent-references.py");
        auto obj = owner.callFunction("make_object", output.path);
        auto callback = owner.callFunction("make_callable", output.path);
        assertEq(17, obj.value());
        assertEq(17, callback());
        delete owner;
        assertRegex("^((object\ncallable\n)|(callable\nobject\n))$", output.file.read(-1));
        assertThrows("PYTHON-INTERPRETER-DELETED", sub() { obj.value(); });
        assertThrows("PYTHON-INTERPRETER-DELETED", sub() { callback(); });
        delete obj;
        callback = NOTHING;
    }

