        pgm2.loadModule("python");
        pgm2.parse("int sub py_len(list<auto> l) { return Python::builtins::len(l); }", "special-len");
        assertEq(3, pgm2.callFunction("py_len", (1, 2, 3)));
    }

    # Python objects for Qore objects hold strong references: a Qore object exists as long as Qore or Python references
    # it, and its destructor runs when the last reference is released; previously every Qore object passed to Python
    # was added to the thread-local _python_save list, so it lived until the thread ended (once per pass), and objects
    # created from Python were saved there as well; an instance of a Python subclass of a Qore class is collected by
    # Python's cycle collector when only it keeps its Qore object alive (it was never collected); the save object
    # callback, which is still called for objects created from Python, runs without the GIL, so it cannot deadlock with
    # a thread that holds a Qore lock and waits for the GIL
    qoreObjectLifetimeTest() {
        PythonProgram p("
import gc
from qore.__root__ import PythonLifecycleTracked

class Sub(PythonLifecycleTracked):
    def get(self):
        return 'python:' + self.name

kept = []

def touch(o):
    return o.get()

def keep(o):
    kept.append(o)

def drop():
    kept.clear()
    gc.collect()

def make_and_drop():
    return PythonLifecycleTracked('dropped').get()

def make():
    return PythonLifecycleTracked('made')

def make_sub():
    s = Sub('sub')
    kept.append(s)
    return s
", "lifetime.py");

        int destroyed = PythonLifecycleTracked::destroyed;
        # a Qore object passed to Python and not kept there is destroyed when its last Qore reference is released
        {
            PythonLifecycleTracked o("passed");
            for (int i = 0; i < 1000; ++i) {
                assertEq("qore:passed", p.callFunction("touch", o));
            }
            assertEq(destroyed, PythonLifecycleTracked::destroyed);
        }
        assertEq(destroyed + 1, PythonLifecycleTracked::destroyed, "destroyed at the end of its scope");
        assertNothing(get_thread_data("_python_save"), "no objects are saved in thread-local data");

        # an object kept in Python lives until Python releases it
        {
            PythonLifecycleTracked o("kept");
            p.callFunction("keep", o);
        }
        assertEq(destroyed + 1, PythonLifecycleTracked::destroyed, "kept in Python");
        p.callFunction("drop");
        assertEq(destroyed + 2, PythonLifecycleTracked::destroyed, "released by Python");

        # objects created from Python
        assertEq("qore:dropped", p.callFunction("make_and_drop"));
        assertEq(destroyed + 3, PythonLifecycleTracked::destroyed, "created and released by Python");
        {
            object o = p.callFunction("make");
            assertEq(destroyed + 3, PythonLifecycleTracked::destroyed, "held by Qore");
            assertEq("qore:made", o.get());
        }
        assertEq(destroyed + 4, PythonLifecycleTracked::destroyed, "released by Qore");

        # an instance of a Python subclass of a Qore class: kept alive by Qore, collected when only Python held it
        {
            object strong = p.callFunction("make_sub");
            p.callFunction("drop");
            assertEq("python:sub", strong.get(), "Qore keeps the Python object alive");
        }
        # a method called through a weak reference to a destroyed object raises OBJECT-ALREADY-DELETED or, depending
        # on Qore's execution mode, runs on the emptied object (qoretechnologies/qore#5509): the object has a member
        # while it exists
        auto weak;
        weak := p.callFunction("make_sub");
        assertTrue(weak.val());
        p.callFunction("drop");
        bool collected;
        try {
            collected = !weak.val();
        } catch (hash<ExceptionInfo> ex) {
            collected = ex.err == "OBJECT-ALREADY-DELETED";
        }
        assertTrue(collected, "collected by Python");

        # the save object callback is called once for each object created from Python, not for objects passed to it
        list<object> saved;
        p.setSaveObjectCallback(sub (object o) { saved += o; });
        on_exit p.setSaveObjectCallback();
        {
            PythonLifecycleTracked o("passed");
            p.callFunction("touch", o);
            p.callFunction("touch", o);
        }
        p.callFunction("make_and_drop");
        assertEq(1, saved.size());
        assertEq("dropped", saved[0].name);

        # the callback runs without the GIL: it waits for a lock held by a thread that calls Python meanwhile
        if (!Python::FreeThreading) {
            Mutex m();
            Queue locked();
            Queue in_callback();
            p.setSaveObjectCallback(sub (object o) {
                in_callback.push(True);
                # the thread holding the lock calls Python, which needs the GIL, before releasing it
                assertEq(0, m.lock(10s), "the lock is released by the thread that calls Python");
                m.unlock();
            });
            background sub () {
                m.lock();
                on_exit m.unlock();
                locked.push(True);
                in_callback.get();
                p.callFunction("touch", new PythonLifecycleTracked("thread"));
            }();
            locked.get();
            p.callFunction("make_and_drop");
        }
    }

    # releasing the last reference to a Qore value from Python (here a closure, whose captured object has a
    # destructor) runs Qore code, which now runs without the GIL: the destructor waits for a lock held by a thread
    # that calls Python meanwhile; previously the destructor ran with the GIL held, and both threads waited forever
    gilReleaseTest() {
        if (Python::FreeThreading) {
            testSkip("there is no GIL with free-threading (PEP 703)");
        }
        PythonProgram p("
kept = []

def keep(c):
    kept.append(c)

def drop():
    kept.clear()

def noop():
    return 1
", "gil-release.py");

        Mutex m();
        Queue locked();
        Queue in_destructor();
        Queue result();
        {
            PythonGilTestLocker o(m, in_destructor, result);
            code c = auto sub () { return o; };
            p.callFunction("keep", c);
        }
        # Python holds the last reference to the closure, which holds the last reference to the object
        background sub () {
            m.lock();
            on_exit m.unlock();
            locked.push(True);
            in_destructor.get();
            p.callFunction("noop");
        }();
        locked.get();
        p.callFunction("drop");
        assertEq(0, result.get(), "the destructor got the lock");
    }

    # the destructor of a Qore class runs for the objects of its Python subclasses, also through other Python classes:
    # the Qore class was a virtual base class of the Qore class of the Python subclass, and Qore does not run the
    # destructor of a virtual base class (nor of the ancestors of one, so a Qore class reached through Python base
    # classes is now a direct, non-virtual base class, and the methods of the Python base classes are added to the
    # subclass so that they take precedence over its methods, as in Python's method resolution order)
    subclassDestructorTest() {
        PythonProgram p("
import gc
from qore.__root__ import PythonLifecycleTracked
from qore.__root__.Qore.Thread import Counter

class Sub(PythonLifecycleTracked):
    def get(self):
        return 'sub:' + self.name

class Sub2(Sub):
    def other(self):
        return 'other'

class Sub3(Sub2):
    def get(self):
        return 'sub3:' + self.name

class MyCounter(Counter):
    pass

class MyCounter2(MyCounter):
    pass

def make(cls, name):
    return globals()[cls](name)

def make_counter():
    c = MyCounter2(2)
    c.dec()
    return c

def collect():
    gc.collect()
", "subclass-destructor.py");

        hash<string, string> expected = {
            "Sub": "sub:",
            "Sub2": "sub:",
            "Sub3": "sub3:",
        };
        foreach hash<auto> c in (expected.pairIterator()) {
            int destroyed = PythonLifecycleTracked::destroyed;
            object o = p.callFunction("make", c.key, c.key);
            assertEq(c.value + c.key, o.get(), c.key + ": the method of the Python class nearest in the MRO");
            assertEq("describe:" + c.value + c.key, o.describe(), c.key + ": Qore code calls the Python override");
            assertEq(c.key, o.name, c.key + ": Qore member");
            delete o;
            assertEq(destroyed + 1, PythonLifecycleTracked::destroyed, c.key + ": the Qore destructor ran");

            # released by Python's cycle collector
            {
                object o2 = p.callFunction("make", c.key, c.key + "-gc");
            }
            p.callFunction("collect");
            assertEq(destroyed + 2, PythonLifecycleTracked::destroyed, c.key + ": the Qore destructor ran (gc)");
        }
        assertEq("other", p.callFunction("make", "Sub3", "x").other(), "a method of a Python base class");

        # a Python subclass of a builtin Qore class, through another Python class
        object counter = p.callFunction("make_counter");
        assertEq(1, counter.getCount());
        counter.dec();
        assertEq(0, counter.getCount());
        delete counter;
    }

    typeConversionTest() {
        # Test datetime.time conversion (covers getQoreDateTimeFromTime fix)
        {
            PythonProgram pp("
import datetime
def get_time():
    return datetime.time(14, 30, 45, 123456)

def get_date():
    return datetime.date(2024, 12, 29)

def get_datetime():
    return datetime.datetime(2024, 12, 29, 14, 30, 45, 123456)

def get_timedelta():
    return datetime.timedelta(days=5, hours=3, minutes=30, seconds=15, microseconds=500)
", "datetime_test.py");

            # Test time conversion
            auto t = pp.callFunction("get_time");
            assertEq(Type::Date, t.type());
            hash<auto> ti = t.info();
            assertEq(14, ti.hour);
            assertEq(30, ti.minute);
            assertEq(45, ti.second);
            assertEq(123456, ti.microsecond);

            # Test date conversion
            auto d = pp.callFunction("get_date");
            assertEq(Type::Date, d.type());
            hash<auto> di = d.info();
            assertEq(2024, di.year);
            assertEq(12, di.month);
            assertEq(29, di.day);

            # Test datetime conversion
            auto dt = pp.callFunction("get_datetime");
            assertEq(Type::Date, dt.type());
            hash<auto> dti = dt.info();
            assertEq(2024, dti.year);
            assertEq(12, dti.month);
            assertEq(29, dti.day);
            assertEq(14, dti.hour);
            assertEq(30, dti.minute);
            assertEq(45, dti.second);

            # Test timedelta conversion
            auto td = pp.callFunction("get_timedelta");
            assertEq(Type::Date, td.type());
            assertTrue(td.relative());
        }

        # Test large integer conversion (> 64-bit should become number)
        {
            PythonProgram pp("
def get_large_int():
    return 2**100

def get_negative_large_int():
